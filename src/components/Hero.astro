---
import Img from './ui/Img.astro';
import { couple, date, hero } from '../data/wedding';
import { heroPhoto, crops } from '../data/photos';
import decor from '../data/decor.json';

// Clapele plicului: aceleași puncte (viewBox 0–100, întins pe tot ecranul) dau și forma hârtiei
// (clip-path pe .env__face) și muchia aurie (polyline doar pe marginile interioare).
const flaps = [
  { k: 'l', pts: '0,0 54,52 0,100' },
  { k: 'r', pts: '100,0 46,52 100,100' },
  { k: 'b', pts: '0,100 50,44 100,100' },
  { k: 't', pts: '0,0 50,58 100,0' },
] as const;
const clip = (pts: string) =>
  `--clip: polygon(${pts
    .split(' ')
    .map((p) => p.split(',').map((v) => (v === '0' ? '0' : `${v}%`)).join(' '))
    .join(', ')})`;
---

<section class="hero" id="acasa" data-hero aria-labelledby="hero-title">
  <div class="hero__sticky">
    <div class="hero__frame" data-hero-frame>
      <div class="hero__media" data-hero-media>
        <Img
          src={heroPhoto.src}
          mobile={crops.heroMobile}
          alt=""
          widths={[1280, 1920, 2048]}
          sizes="100vw"
          mobileWidths={[540, 720, 902]}
          mobileSizes="100vw"
          priority
          hq
          class="hero__pic"
          imgClass="hero__img"
          imgAttrs={{ 'data-hero-img': '' }}
        />
      </div>
      <div class="hero__shade" data-hero-shade></div>
      <!-- Lumina caldă „din interiorul plicului" care se revarsă peste poză când se deschide. -->
      <div class="hero__glow" data-hero-glow aria-hidden="true"></div>
    </div>

    <!-- Plicul (doar cu animații): patru clape de catifea cu muchii aurii; sigiliul se rupe la primul
         scroll (sau la atingere), clapele se deschid și descoperă poza. -->
    <div class="env" data-env aria-hidden="true">
      <svg class="env__defs" width="0" height="0" focusable="false">
        <radialGradient id="env-foil" gradientUnits="userSpaceOnUse" cx="50" cy="54" r="62">
          <stop offset="0" stop-color="#fff3cf" stop-opacity="0.95"></stop>
          <stop offset="0.35" stop-color="#e8d09a" stop-opacity="0.7"></stop>
          <stop offset="1" stop-color="#9a7634" stop-opacity="0.3"></stop>
        </radialGradient>
      </svg>
      {
        flaps.map((f) => (
          <div class:list={['env__flap', `env__flap--${f.k}`]} style={clip(f.pts)} {...{ [`data-env-${f.k}`]: '' }}>
            <div class="env__paper">
              <div class="env__face"></div>
              <svg viewBox="0 0 100 100" preserveAspectRatio="none" focusable="false">
                <polyline points={f.pts}></polyline>
              </svg>
            </div>
            {f.k === 't' && <div class="env__shine" data-env-shine></div>}
          </div>
        ))
      }
      <span class="env__seal" data-env-seal>
        <span class="env__seal-lift">
          <span class="env__seal-shadow" data-seal-shadow></span>
          <!-- sigiliul întreg (ascunde linia fină dintre jumătăți cât e intact) -->
          <img class="env__seal-img env__seal-whole" data-seal-whole src="/decor/seal.webp" alt="" width={decor.seal.w} height={decor.seal.h} decoding="async" />
          {
            (['l', 'r'] as const).map((side) => (
              <span class:list={['env__seal-half', `env__seal-half--${side}`]} data-seal-l={side === 'l' ? '' : undefined} data-seal-r={side === 'r' ? '' : undefined}>
                <img class="env__seal-img" src="/decor/seal.webp" alt="" width={decor.seal.w} height={decor.seal.h} decoding="async" />
              </span>
            ))
          }
          <svg class="env__crack" data-seal-crack viewBox="0 0 100 100" focusable="false">
            <polyline points="53,0 47,24 55,46 46,70 52,100"></polyline>
          </svg>
          <span class="env__seal-glint" data-seal-glint><i></i></span>
        </span>
      </span>
      <!-- Efectele de la ruperea sigiliului: bloom cald + o dâră de lumină care trece peste hârtie. -->
      <span class="env__bloom" data-env-bloom></span>
      <span class="env__glare" data-env-glare><i></i></span>
    </div>
    <button class="env__open" type="button" data-env-open aria-label={hero.openLabel}></button>

    <!-- Pe plic nu e niciun text, doar sigiliul cu inițialele. Cartonul de titlu (nume + dată)
         apare abia când plicul s-a deschis, peste poză, ca genericul unui film. -->
    <div class="hero__caption" data-hero-caption>
      <h1 class="hero__title" id="hero-title" tabindex="-1">
        <!-- Textul pentru cititoarele de ecran stă în afara textului auriu: background-clip: text
             desenează și literele ascunse cu .sr-only. -->
        <span class="sr-only">{couple.bride} și {couple.groom}, {date.long}</span>
        <span class="gold-text hero__names" aria-hidden="true">
          <span class="hero__n">{couple.bride}</span>
          <span class="hero__n"><span class="hero__amp">&amp;</span> {couple.groom}</span>
        </span>
        <span class="hero__date" aria-hidden="true">
          <time datetime={date.start.slice(0, 10)}>{date.short}</time>
        </span>
      </h1>
    </div>

    <a class="hero__scroll" href="#povestea" data-hero-fade aria-label={hero.scrollHint}>
      <i aria-hidden="true"></i>
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 100svh;
    min-height: 34rem;
    background: var(--night);
    color: var(--ivory);
  }
  /* Pin mai scurt pe mobil (mai puțin „scroll gol" cu degetul). svh = stabil cu bara de adresă. */
  :global(.motion-ok) .hero {
    height: 200vh;
    height: 200svh;
  }
  @media (min-width: 1024px) {
    :global(.motion-ok) .hero {
      height: 230svh;
    }
  }
  .hero__sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    min-height: 34rem;
    overflow: hidden;
    display: grid;
  }
  .hero__frame {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--night);
  }
  .hero__media {
    position: absolute;
    inset: 0;
    transform-origin: 50% 45%;
  }
  /* Straturi proprii pe GPU (iOS Safari nu le promovează singur pentru transform-uri 2D):
     poza și titlul nu se mai re-randează la fiecare frame de scroll. */
  :global(.motion-ok) .hero__media {
    will-change: transform;
    backface-visibility: hidden;
  }
  .hero__media :global(.hero__pic),
  .hero__media :global(.hero__img) {
    width: 100%;
    height: 100%;
  }
  .hero__media :global(.hero__img) {
    object-fit: cover;
    object-position: 50% 30%;
    background-color: var(--night);
  }
  @media (min-width: 768px) {
    .hero__media :global(.hero__img) {
      object-position: 30% 50%;
    }
  }
  .hero__shade {
    position: absolute;
    inset: 0;
    /* Doar cât să se citească header-ul (sus) și data (jos); poza rămâne luminoasă. */
    background:
      linear-gradient(to top, rgb(6 20 13 / 0.92) 0%, rgb(6 20 13 / 0.62) 22%, rgb(6 20 13 / 0.18) 40%, transparent 52%),
      linear-gradient(to bottom, rgb(6 20 13 / 0.5), transparent 18%);
  }

  /* Lumina din plic: se revarsă (screen) peste poză cât se deschid clapele; doar opacity (motion.ts). */
  .hero__glow {
    display: none;
  }
  :global(.motion-ok) .hero__glow {
    display: block;
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 46% 38% at 50% 50%, rgb(255 238 200 / 0.55), rgb(232 196 120 / 0.2) 45%, transparent 75%),
      radial-gradient(ellipse 90% 70% at 50% 50%, rgb(201 165 90 / 0.16), transparent 70%);
    mix-blend-mode: screen;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  /* ── Plicul ─────────────────────────────────────────────────────────── */
  .env,
  .env__open {
    display: none;
  }
  .hero__sticky {
    /* sigiliul: dimensiune comună pentru ceară, butonul de deschidere și bloom */
    --seal: clamp(5rem, 22vw, 6.75rem);
    --seal-y: 58%;
  }
  @media (min-width: 1024px) {
    .hero__sticky {
      --seal: 7.5rem;
    }
  }
  :global(.motion-ok) .env {
    display: block;
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    perspective: 1400px;
  }
  .env__defs {
    position: absolute;
  }
  .env__flap {
    position: absolute;
    inset: 0;
    will-change: transform;
    backface-visibility: hidden;
  }
  .env__paper,
  .env__face,
  .env__shine {
    position: absolute;
    inset: 0;
  }
  /* PERFORMANȚĂ: umbra (filter) stă pe .env__paper, NU pe .env__flap. Clapa e strat GPU (will-change),
     iar un filter pe stratul însuși e recalculat de compozitor la FIECARE frame (4 straturi cât
     ecranul + blur → sacadat pe GPU-uri integrate / monitoare 4K-5K). Pe copil, umbra se
     rasterizează o singură dată în textura clapei, care apoi doar se mișcă. */
  .env__paper {
    /* WebKit: copilul cu filter nu moștenește ascunderea feței din spate a clapei rotite la 180°. */
    backface-visibility: hidden;
  }
  /* Hârtia: catifea (aceeași textură de 8 KB ca secțiunile) + lumină. Toate clapele acoperă tot
     ecranul, deci „lumina de scenă" (pata caldă din jurul sigiliului + vigneta) e un singur câmp
     continuu peste clape; --shade dă fiecărei clape tonul ei (cea de sus e cea mai luminată,
     buzunarul lateral cel mai adânc), iar --tex decalează textura ca să nu pară o singură foaie. */
  .env__face {
    clip-path: var(--clip);
    background:
      radial-gradient(ellipse 62% 48% at 50% var(--seal-y), rgb(255 232 180 / 0.1), rgb(255 232 180 / 0.03) 55%, transparent 80%),
      radial-gradient(ellipse 120% 95% at 50% 52%, transparent 42%, rgb(2 9 5 / 0.6) 100%),
      var(--shade),
      url('/decor/velvet.webp') var(--tex, 0 0) / 512px 512px,
      #0b2418;
  }
  .env__flap svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  /* Muchia aurie (folio): doar pe marginile interioare, mai luminoasă spre sigiliu. */
  .env__flap polyline {
    fill: none;
    stroke: url(#env-foil);
    stroke-width: 1.25;
    vector-effect: non-scaling-stroke;
    stroke-linejoin: round;
  }
  .env__flap--l {
    --shade: linear-gradient(90deg, rgb(0 0 0 / 0.05), rgb(0 0 0 / 0.3) 54%);
    --tex: 173px 61px;
  }
  .env__flap--r {
    --shade: linear-gradient(270deg, rgb(0 0 0 / 0.05), rgb(0 0 0 / 0.3) 54%);
    --tex: 311px 227px;
  }
  .env__flap--l .env__paper {
    filter: drop-shadow(5px 0 12px rgb(0 0 0 / 0.32));
  }
  .env__flap--r .env__paper {
    filter: drop-shadow(-5px 0 12px rgb(0 0 0 / 0.32));
  }
  .env__flap--b {
    z-index: 1;
    --shade: linear-gradient(0deg, rgb(255 246 225 / 0.035), rgb(0 0 0 / 0.16) 56%);
    --tex: 97px 389px;
  }
  .env__flap--b .env__paper {
    filter: drop-shadow(0 -5px 14px rgb(0 0 0 / 0.34));
  }
  .env__flap--t {
    z-index: 2;
    transform-origin: 50% 0;
    --shade: linear-gradient(180deg, rgb(255 246 225 / 0.075), rgb(255 246 225 / 0.035) 50%, rgb(0 0 0 / 0.06) 58%);
  }
  .env__flap--t .env__paper {
    filter: drop-shadow(0 12px 22px rgb(0 0 0 / 0.42));
  }
  /* Reflexul de pe clapa de sus cât se ridică spre privitor (opacity, motion.ts). */
  .env__shine {
    clip-path: var(--clip);
    background: linear-gradient(176deg, rgb(255 226 168 / 0.13), rgb(255 226 168 / 0.04) 50%, transparent 85%);
    opacity: 0;
    backface-visibility: hidden;
  }

  .env__seal {
    position: absolute;
    z-index: 3;
    left: 50%;
    top: var(--seal-y);
    width: var(--seal);
    aspect-ratio: 1;
    margin: calc(var(--seal) / -2) 0 0 calc(var(--seal) / -2);
    will-change: transform, opacity;
  }
  .env__seal-lift,
  .env__seal-shadow,
  .env__seal-half,
  .env__crack {
    position: absolute;
    inset: 0;
  }
  /* Răspuns la hover / apăsare pe butonul de peste sigiliu (CSS, fără JS). */
  .env__seal-lift {
    transition: transform 0.6s var(--ease-out);
  }
  .hero__sticky:has(.env__open:hover) .env__seal-lift {
    transform: translateY(-3px) scale(1.04);
  }
  .hero__sticky:has(.env__open:active) .env__seal-lift {
    transform: scale(0.96);
    transition-duration: 0.15s;
  }
  /* Sigiliul e o imagine (ceară aurie cu D&D gravat, public/decor/seal.webp). Dedesubt: umbra de
     contact, una largă și moale, plus un reflex auriu pe hârtie. */
  .env__seal-shadow {
    inset: 6%;
    border-radius: 47% 53% 50% 50% / 52% 48% 52% 48%;
    box-shadow:
      0 4px 8px rgb(0 0 0 / 0.5),
      0 16px 34px -6px rgb(0 0 0 / 0.55),
      0 0 46px 10px rgb(201 165 90 / 0.14);
  }
  .env__seal-half {
    will-change: transform, opacity;
  }
  .env__seal-whole {
    position: absolute;
    inset: 0;
  }
  .env__seal-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  /* Ce trece peste ceară e decupat exact pe forma sigiliului (masca = aceeași imagine, deja încărcată). */
  .env__seal-glint,
  .env__crack {
    -webkit-mask: url('/decor/seal.webp') center / contain no-repeat;
    mask: url('/decor/seal.webp') center / contain no-repeat;
    pointer-events: none;
  }
  /* Sclipirea de pe ceară: o dungă de lumină mutată doar prin transform (GSAP, motion.ts). */
  .env__seal-glint {
    position: absolute;
    inset: 0;
    overflow: hidden;
    mix-blend-mode: screen;
  }
  .env__seal-glint i {
    position: absolute;
    inset: -20% 30%;
    background: linear-gradient(
      100deg,
      transparent 18%,
      rgb(255 236 196 / 0.3) 38%,
      rgb(255 250 236 / 0.95) 50%,
      rgb(255 236 196 / 0.3) 62%,
      transparent 82%
    );
    transform: translateX(-180%) rotate(14deg);
    will-change: transform;
  }
  /* Crăpătura care se aprinde o clipă înainte ca sigiliul să se rupă. */
  .env__crack {
    width: 100%;
    height: 100%;
    overflow: visible;
    opacity: 0;
  }
  .env__crack polyline {
    fill: none;
    stroke: #fff1cc;
    stroke-width: 1.6;
    stroke-linejoin: round;
    filter: drop-shadow(0 0 2px rgb(255 214 140)) drop-shadow(0 0 6px rgb(232 182 98 / 0.8));
  }
  /* Linia de crăpătură (zimțată) dintre cele două jumătăți ale sigiliului. */
  .env__seal-half--l {
    clip-path: polygon(0 0, 53% 0, 47% 24%, 55% 46%, 46% 70%, 52% 100%, 0 100%);
  }
  .env__seal-half--r {
    clip-path: polygon(53% 0, 100% 0, 100% 100%, 52% 100%, 46% 70%, 55% 46%, 47% 24%);
  }

  /* Bloom-ul de la ruperea sigiliului: lumină caldă, moale (fără alb pur), crește din sigiliu.
     Element mic scalat (textură mică pe GPU); vizibil doar cât rulează efectul (autoAlpha). */
  .env__bloom {
    position: absolute;
    z-index: 4;
    left: 50%;
    top: var(--seal-y);
    width: 64vmax;
    height: 64vmax;
    margin: -32vmax 0 0 -32vmax;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgb(255 236 196 / 0.7) 0%,
      rgb(252 214 150 / 0.42) 6%,
      rgb(232 182 98 / 0.2) 16%,
      rgb(201 150 70 / 0.08) 32%,
      transparent 56%
    );
    mix-blend-mode: screen;
    opacity: 0;
    visibility: hidden;
  }
  /* Dâra de lumină care mătură hârtia (ca o lumină care prinde catifeaua când se mișcă plicul). */
  .env__glare {
    position: absolute;
    z-index: 4;
    inset: 0;
    overflow: hidden;
    mix-blend-mode: screen;
    opacity: 0;
    visibility: hidden;
  }
  /* banda e rotită (nu gradient oblic), deci arată la fel pe telefon (înalt) și pe desktop (lat) */
  .env__glare i {
    position: absolute;
    top: -60%;
    left: 50%;
    width: 22vmax;
    height: 220%;
    margin-left: -11vmax;
    background: linear-gradient(
      90deg,
      transparent,
      rgb(255 222 160 / 0.04) 25%,
      rgb(255 236 196 / 0.15) 50%,
      rgb(255 222 160 / 0.04) 75%,
      transparent
    );
    transform: translateX(-100vmax) rotate(22deg);
  }

  /* Butonul de peste sigiliu: atingere / Enter deschide plicul (derulează animat până la poză). */
  :global(.motion-ok) .env__open {
    display: block;
    position: absolute;
    z-index: 5;
    left: 50%;
    top: var(--seal-y);
    width: calc(var(--seal) + 1rem);
    aspect-ratio: 1;
    margin: calc(var(--seal) / -2 - 0.5rem) 0 0 calc(var(--seal) / -2 - 0.5rem);
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    -webkit-tap-highlight-color: transparent;
  }
  .env__open:focus-visible {
    outline-offset: 2px;
    border-radius: 50%;
  }
  .hero__title:focus {
    outline: none;
  }

  /* Cartonul de titlu: jos, peste scrim-ul de la baza pozei (nu peste fețe). */
  .hero__caption {
    position: absolute;
    z-index: 4;
    left: var(--gutter);
    right: var(--gutter);
    bottom: calc(var(--seam) + 0.75rem);
    display: grid;
    justify-items: center;
    text-align: center;
    pointer-events: none;
  }
  :global(.motion-ok) .hero__names,
  :global(.motion-ok) .hero__date {
    opacity: 0;
  }
  .hero__title {
    display: grid;
    justify-items: center;
    gap: 0.35rem;
    font-weight: 400;
  }
  .hero__names {
    font-family: var(--serif);
    font-size: clamp(2.6rem, 12vw, 7.5rem);
    line-height: 1.15;
    white-space: nowrap;
    /* background-clip: text pictează doar în caseta elementului; floriturile scriptului
       (D, &, ș) ies din caseta de avans și rămâneau tăiate. Padding generos + margin negativ
       (poziția rămâne aceeași). */
    padding: 0.2em 0.45em 0.4em;
    margin: -0.2em -0.45em -0.4em;
  }
  .hero__amp {
    font-size: 0.8em;
  }
  .hero__date {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    font-family: var(--text);
    font-size: clamp(0.9rem, 1.6vw, 1.05rem);
    font-weight: 600;
    letter-spacing: 0.32em;
    text-indent: 0.32em;
    color: var(--ivory);
    text-shadow: 0 2px 14px rgb(6 20 13 / 0.6);
  }
  .hero__date::before,
  .hero__date::after {
    content: '';
    width: clamp(1.5rem, 6vw, 3.5rem);
    height: 1px;
    background: linear-gradient(to var(--dir, left), var(--amber), transparent);
  }
  .hero__date::after {
    --dir: right;
  }
  /* Desktop: cuplul stă în centrul pozei, deci cartonul de titlu trece în colțul din stânga-jos
     (pe două rânduri), peste un scrim lateral; textul și subiectul nu se suprapun. */
  @media (min-width: 1024px) {
    .hero__shade {
      background:
        linear-gradient(to right, rgb(6 20 13 / 0.78) 0%, rgb(6 20 13 / 0.45) 24%, transparent 42%),
        linear-gradient(to top, rgb(6 20 13 / 0.85) 0%, rgb(6 20 13 / 0.35) 20%, transparent 40%),
        linear-gradient(to bottom, rgb(6 20 13 / 0.5), transparent 18%);
    }
    .hero__caption {
      /* lipit de marginea din stânga a ecranului (nu de coloana centrată): cuplul stă la ~38–60% din lățime. */
      left: var(--gutter);
      right: auto;
      bottom: calc(var(--seam) + 1.5rem);
      justify-items: start;
      text-align: left;
    }
    .hero__title {
      justify-items: start;
      gap: 0.6rem;
    }
    .hero__names {
      display: grid;
      font-size: clamp(4rem, 5.2vw, 6rem);
      line-height: 1.05;
    }
    .hero__n + .hero__n {
      padding-left: 0.55em;
    }
    .hero__date {
      text-indent: 0;
    }
    .hero__date::before {
      display: none;
    }
  }

  .hero__scroll {
    position: absolute;
    z-index: 4;
    left: 50%;
    bottom: calc(1.25rem + env(safe-area-inset-bottom));
    translate: -50% 0;
    display: grid;
    justify-items: center;
    gap: 0.6rem;
    min-width: 44px;
    padding: 0.25rem 0.5rem;
    font-size: 0.95rem;
    text-decoration: none;
    color: var(--on-dark-soft);
  }
  .hero__scroll i {
    position: relative;
    width: 1px;
    height: 2.75rem;
    background: rgb(244 237 225 / 0.2);
    overflow: hidden;
  }
  .hero__scroll i::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--amber);
    transform: translateY(-100%);
    animation: scroll-line 2.2s var(--ease-in-out) infinite;
  }
  /* Oprită cât hero-ul e în afara ecranului (.is-off din motion.ts); altfel ținea pagina „trează". */
  .hero__scroll:global(.is-off) i::after {
    animation-play-state: paused;
  }
  @keyframes scroll-line {
    0% {
      transform: translateY(-100%);
    }
    55% {
      transform: translateY(0);
    }
    100% {
      transform: translateY(100%);
    }
  }
