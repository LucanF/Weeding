---
import Img from './ui/Img.astro';
import { couple, date, hero } from '../data/wedding';
import { heroPhoto, crops } from '../data/photos';
import decor from '../data/decor.json';
---

<section class="hero" id="acasa" data-hero aria-labelledby="hero-title">
  <div class="hero__sticky">
    <div class="hero__frame" data-hero-frame>
      <div class="hero__media" data-hero-media>
        <Img
          src={heroPhoto.src}
          mobile={crops.heroMobile}
          alt=""
          widths={[1280, 1920, 2048]}
          sizes="100vw"
          mobileWidths={[540, 720, 902]}
          mobileSizes="100vw"
          priority
          hq
          class="hero__pic"
          imgClass="hero__img"
          imgAttrs={{ 'data-hero-img': '' }}
        />
      </div>
      <div class="hero__shade" data-hero-shade></div>
    </div>

    <!-- Plicul (doar cu animații): patru clape care se deschid la scroll și descoperă poza. -->
    <div class="env" data-env aria-hidden="true">
      <div class="env__flap env__flap--l" data-env-l>
        <svg viewBox="0 0 100 100" preserveAspectRatio="none" focusable="false"><polygon points="0,0 54,52 0,100"></polygon></svg>
      </div>
      <div class="env__flap env__flap--r" data-env-r>
        <svg viewBox="0 0 100 100" preserveAspectRatio="none" focusable="false"><polygon points="100,0 46,52 100,100"></polygon></svg>
      </div>
      <div class="env__flap env__flap--b" data-env-b>
        <svg viewBox="0 0 100 100" preserveAspectRatio="none" focusable="false"><polygon points="0,100 50,44 100,100"></polygon></svg>
      </div>
      <div class="env__flap env__flap--t" data-env-t>
        <svg viewBox="0 0 100 100" preserveAspectRatio="none" focusable="false"><polygon points="0,0 100,0 50,58"></polygon></svg>
      </div>
      <span class="env__seal" data-env-seal>
        <span class="env__seal-shadow" data-seal-shadow></span>
        {
          (['l', 'r'] as const).map((side) => (
            <span class:list={['env__seal-half', `env__seal-half--${side}`]} data-seal-l={side === 'l' ? '' : undefined} data-seal-r={side === 'r' ? '' : undefined}>
              <img class="env__seal-img" src="/decor/seal.webp" alt="" width={decor.seal.w} height={decor.seal.h} decoding="async" />
            </span>
          ))
        }
        <span class="env__seal-glint" data-seal-glint><i></i></span>
      </span>
    </div>

    <!-- Pe plic nu e niciun text, doar sigiliul cu inițialele. Cartonul de titlu (nume + dată)
         apare abia când plicul s-a deschis, peste poză, ca genericul unui film. -->
    <div class="hero__caption" data-hero-caption>
      <h1 class="hero__title" id="hero-title">
        <!-- Textul pentru cititoarele de ecran stă în afara textului auriu: background-clip: text
             desenează și literele ascunse cu .sr-only. -->
        <span class="sr-only">{couple.bride} și {couple.groom}, {date.long}</span>
        <span class="gold-text hero__names" aria-hidden="true">
          <span class="hero__n">{couple.bride}</span>
          <span class="hero__n"><span class="hero__amp">&amp;</span> {couple.groom}</span>
        </span>
        <span class="hero__date" aria-hidden="true">
          <time datetime={date.start.slice(0, 10)}>{date.short}</time>
        </span>
      </h1>
    </div>

    <a class="hero__scroll" href="#povestea" data-hero-fade aria-label={hero.scrollHint}>
      <i aria-hidden="true"></i>
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 100svh;
    min-height: 34rem;
    background: var(--night);
    color: var(--ivory);
  }
  /* Pin mai scurt pe mobil (mai puțin „scroll gol" cu degetul). svh = stabil cu bara de adresă. */
  :global(.motion-ok) .hero {
    height: 200vh;
    height: 200svh;
  }
  @media (min-width: 1024px) {
    :global(.motion-ok) .hero {
      height: 230svh;
    }
  }
  .hero__sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    min-height: 34rem;
    overflow: hidden;
    display: grid;
  }
  .hero__frame {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--night);
  }
  .hero__media {
    position: absolute;
    inset: 0;
    transform-origin: 50% 45%;
  }
  /* Straturi proprii pe GPU (iOS Safari nu le promovează singur pentru transform-uri 2D):
     poza și titlul nu se mai re-randează la fiecare frame de scroll. */
  :global(.motion-ok) .hero__media {
    will-change: transform;
    backface-visibility: hidden;
  }
  .hero__media :global(.hero__pic),
  .hero__media :global(.hero__img) {
    width: 100%;
    height: 100%;
  }
  .hero__media :global(.hero__img) {
    object-fit: cover;
    object-position: 50% 30%;
    background-color: var(--night);
  }
  @media (min-width: 768px) {
    .hero__media :global(.hero__img) {
      object-position: 30% 50%;
    }
  }
  .hero__shade {
    position: absolute;
    inset: 0;
    /* Doar cât să se citească header-ul (sus) și data (jos); poza rămâne luminoasă. */
    background:
      linear-gradient(to top, rgb(6 20 13 / 0.92) 0%, rgb(6 20 13 / 0.62) 22%, rgb(6 20 13 / 0.18) 40%, transparent 52%),
      linear-gradient(to bottom, rgb(6 20 13 / 0.5), transparent 18%);
  }

  /* ── Plicul ─────────────────────────────────────────────────────────── */
  .env {
    display: none;
  }
  :global(.motion-ok) .env {
    display: block;
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    perspective: 1400px;
  }
  .env__flap {
    position: absolute;
    inset: 0;
    will-change: transform;
    backface-visibility: hidden;
  }
  .env__flap svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .env__flap polygon {
    stroke: rgb(201 165 90 / 0.55);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    stroke-linejoin: round;
  }
  .env__flap--l polygon,
  .env__flap--r polygon {
    fill: #0a2016;
  }
  /* Umbre fine: clapele par suprapuse, iar când ies din ecran își poartă umbra peste poză.
     PERFORMANȚĂ: umbra stă pe <svg>-ul din clapă, NU pe .env__flap. Clapa e strat GPU (will-change),
     iar un filter pe stratul însuși e recalculat de compozitor la FIECARE frame (4 straturi cât
     ecranul + blur → sacadat pe GPU-uri integrate / monitoare 4K-5K). Pe copil, umbra se
     rasterizează o singură dată în textura clapei, care apoi doar se mișcă. Aspect identic. */
  .env__flap--l svg {
    filter: drop-shadow(4px 0 10px rgb(0 0 0 / 0.28));
  }
  .env__flap--r svg {
    filter: drop-shadow(-4px 0 10px rgb(0 0 0 / 0.28));
  }
  .env__flap--b {
    z-index: 1;
  }
  .env__flap--b svg {
    filter: drop-shadow(0 -4px 12px rgb(0 0 0 / 0.3));
  }
  .env__flap--b polygon {
    fill: #0d251a;
  }
  .env__flap--t {
    z-index: 2;
    transform-origin: 50% 0;
  }
  .env__flap--t svg {
    filter: drop-shadow(0 10px 18px rgb(0 0 0 / 0.35));
    /* WebKit: copilul cu filter nu moștenește ascunderea feței din spate a clapei rotite la 180°
       (rămânea o linie aurie de 1px sus); o repetăm aici. */
    backface-visibility: hidden;
  }
  .env__flap--t polygon {
    fill: #123020;
  }
  .env__seal {
    position: absolute;
    z-index: 3;
    left: 50%;
    top: 58%;
    width: clamp(4.75rem, 20vw, 6.5rem);
    aspect-ratio: 1;
    margin: calc(clamp(4.75rem, 20vw, 6.5rem) / -2) 0 0 calc(clamp(4.75rem, 20vw, 6.5rem) / -2);
    will-change: transform, opacity;
  }
  .env__seal-shadow,
  .env__seal-half {
    position: absolute;
    inset: 0;
  }
  /* Sigiliul e o imagine (ceară aurie cu D&D gravat, public/decor/seal.webp); umbra stă sub ea. */
  .env__seal-shadow {
    inset: 6%;
    border-radius: 47% 53% 50% 50% / 52% 48% 52% 48%;
    box-shadow: 0 6px 16px rgb(0 0 0 / 0.45);
  }
  .env__seal-half {
    will-change: transform, opacity;
  }
  .env__seal-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  /* Sclipirea de pe ceară: o dungă de lumină mutată doar prin transform (GSAP, motion.ts). */
  .env__seal-glint {
    position: absolute;
    inset: 8%;
    border-radius: 47% 53% 50% 50% / 52% 48% 52% 48%;
    overflow: hidden;
    pointer-events: none;
  }
  .env__seal-glint i {
    position: absolute;
    inset: -10% 25%;
    background: linear-gradient(100deg, transparent 20%, rgb(255 248 225 / 0.55) 50%, transparent 80%);
    transform: translateX(-160%) rotate(12deg);
    will-change: transform;
  }
  /* Linia de crăpătură (zimțată) dintre cele două jumătăți ale sigiliului. */
  .env__seal-half--l {
    clip-path: polygon(0 0, 53% 0, 47% 24%, 55% 46%, 46% 70%, 52% 100%, 0 100%);
  }
  .env__seal-half--r {
    clip-path: polygon(53% 0, 100% 0, 100% 100%, 52% 100%, 46% 70%, 55% 46%, 47% 24%);
  }
  @media (min-width: 1024px) {
    .env__seal {
      width: 7rem;
      margin: -3.5rem 0 0 -3.5rem;
    }
  }

  /* Cartonul de titlu: jos, peste scrim-ul de la baza pozei (nu peste fețe). */
  .hero__caption {
    position: absolute;
    z-index: 4;
    left: var(--gutter);
    right: var(--gutter);
    bottom: calc(var(--seam) + 0.75rem);
    display: grid;
    justify-items: center;
    text-align: center;
    pointer-events: none;
  }
  :global(.motion-ok) .hero__names,
  :global(.motion-ok) .hero__date {
    opacity: 0;
  }
  .hero__title {
    display: grid;
    justify-items: center;
    gap: 0.35rem;
    font-weight: 400;
  }
  .hero__names {
    font-family: var(--serif);
    font-size: clamp(2.6rem, 12vw, 7.5rem);
    line-height: 1.15;
    white-space: nowrap;
    /* background-clip: text pictează doar în caseta elementului; floriturile scriptului
       (D, &, ș) ies din caseta de avans și rămâneau tăiate. Padding generos + margin negativ
       (poziția rămâne aceeași). */
    padding: 0.2em 0.45em 0.4em;
    margin: -0.2em -0.45em -0.4em;
  }
  .hero__amp {
    font-size: 0.8em;
  }
  .hero__date {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    font-family: var(--text);
    font-size: clamp(0.9rem, 1.6vw, 1.05rem);
    font-weight: 600;
    letter-spacing: 0.32em;
    text-indent: 0.32em;
    color: var(--ivory);
    text-shadow: 0 2px 14px rgb(6 20 13 / 0.6);
  }
  .hero__date::before,
  .hero__date::after {
    content: '';
    width: clamp(1.5rem, 6vw, 3.5rem);
    height: 1px;
    background: linear-gradient(to var(--dir, left), var(--amber), transparent);
  }
  .hero__date::after {
    --dir: right;
  }
  /* Desktop: cuplul stă în centrul pozei, deci cartonul de titlu trece în colțul din stânga-jos
     (pe două rânduri), peste un scrim lateral; textul și subiectul nu se suprapun. */
  @media (min-width: 1024px) {
    .hero__shade {
      background:
        linear-gradient(to right, rgb(6 20 13 / 0.78) 0%, rgb(6 20 13 / 0.45) 24%, transparent 42%),
        linear-gradient(to top, rgb(6 20 13 / 0.85) 0%, rgb(6 20 13 / 0.35) 20%, transparent 40%),
        linear-gradient(to bottom, rgb(6 20 13 / 0.5), transparent 18%);
    }
    .hero__caption {
      /* lipit de marginea din stânga a ecranului (nu de coloana centrată): cuplul stă la ~38–60% din lățime. */
      left: var(--gutter);
      right: auto;
      bottom: calc(var(--seam) + 1.5rem);
      justify-items: start;
      text-align: left;
    }
    .hero__title {
      justify-items: start;
      gap: 0.6rem;
    }
    .hero__names {
      display: grid;
      font-size: clamp(4rem, 5.2vw, 6rem);
      line-height: 1.05;
    }
    .hero__n + .hero__n {
      padding-left: 0.55em;
    }
    .hero__date {
      text-indent: 0;
    }
    .hero__date::before {
      display: none;
    }
  }

  .hero__scroll {
    position: absolute;
    z-index: 4;
    left: 50%;
    bottom: calc(1.25rem + env(safe-area-inset-bottom));
    translate: -50% 0;
    display: grid;
    justify-items: center;
    gap: 0.6rem;
    min-width: 44px;
    padding: 0.25rem 0.5rem;
    font-size: 0.95rem;
    text-decoration: none;
    color: var(--on-dark-soft);
  }
  .hero__scroll i {
    position: relative;
    width: 1px;
    height: 2.75rem;
    background: rgb(244 237 225 / 0.2);
    overflow: hidden;
  }
  .hero__scroll i::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--amber);
    transform: translateY(-100%);
    animation: scroll-line 2.2s var(--ease-in-out) infinite;
  }
  /* Oprită cât hero-ul e în afara ecranului (.is-off din motion.ts); altfel ținea pagina „trează". */
  .hero__scroll:global(.is-off) i::after {
    animation-play-state: paused;
  }
  @keyframes scroll-line {
    0% {
      transform: translateY(-100%);
    }
    55% {
      transform: translateY(0);
    }
    100% {
      transform: translateY(100%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__scroll i::after {
      animation: none;
      transform: none;
    }
  }


</style>
