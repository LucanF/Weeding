---
import Img from './ui/Img.astro';
import { couple, date, hero } from '../data/wedding';
import { photos, crops } from '../data/photos';
---

<section class="hero" id="acasa" data-hero aria-labelledby="hero-title">
  <div class="hero__sticky">
    <div class="hero__frame" data-hero-frame>
      <div class="hero__media" data-hero-media>
        <Img
          src={photos.arcada.src}
          mobile={crops.heroMobile}
          alt=""
          widths={[1280, 1920, 2048]}
          sizes="100vw"
          mobileWidths={[540, 720, 902]}
          mobileSizes="100vw"
          priority
          class="hero__pic"
          imgClass="hero__img"
          imgAttrs={{ 'data-hero-img': '' }}
        />
      </div>
      <div class="hero__shade" data-hero-shade></div>
    </div>

    <!-- Plicul (doar cu animații): patru clape care se deschid la scroll și descoperă poza. -->
    <div class="env" data-env aria-hidden="true">
      <div class="env__flap env__flap--l" data-env-l>
        <svg viewBox="0 0 100 100" preserveAspectRatio="none" focusable="false"><polygon points="0,0 54,52 0,100"></polygon></svg>
      </div>
      <div class="env__flap env__flap--r" data-env-r>
        <svg viewBox="0 0 100 100" preserveAspectRatio="none" focusable="false"><polygon points="100,0 46,52 100,100"></polygon></svg>
      </div>
      <div class="env__flap env__flap--b" data-env-b>
        <svg viewBox="0 0 100 100" preserveAspectRatio="none" focusable="false"><polygon points="0,100 50,44 100,100"></polygon></svg>
      </div>
      <div class="env__flap env__flap--t" data-env-t>
        <svg viewBox="0 0 100 100" preserveAspectRatio="none" focusable="false"><polygon points="0,0 100,0 50,58"></polygon></svg>
      </div>
      <span class="env__seal" data-env-seal>
        <span class="env__seal-shadow" data-seal-shadow></span>
        {
          (['l', 'r'] as const).map((side) => (
            <span class:list={['env__seal-half', `env__seal-half--${side}`]} data-seal-l={side === 'l' ? '' : undefined} data-seal-r={side === 'r' ? '' : undefined}>
              <span class="env__seal-mono">
                {couple.monogram[0]}
                <span class="env__seal-amp">&amp;</span>
                {couple.monogram[1]}
              </span>
            </span>
          ))
        }
      </span>
    </div>

    <div class="hero__content">
      <p class="kicker kicker--center hero__eyebrow" data-hero-fade>{hero.eyebrow}</p>
      <h1 class="hero__title" id="hero-title" data-hero-title>
        <span class="sr-only">{couple.bride} și {couple.groom}</span>
        <span class="hero__visual" aria-hidden="true">
          <span class="hero__name" data-split>{couple.bride}</span>
          <span class="hero__amp amp" data-hero-amp>&amp;</span>
          <span class="hero__name" data-split>{couple.groom}</span>
        </span>
      </h1>
    </div>

    <p class="hero__date" data-hero-fade>
      <time datetime={date.start.slice(0, 10)}>{date.long}</time>
    </p>

    <p class="hero__caption" data-hero-caption aria-hidden="true">
      <span class="hero__caption-date">{date.short}</span>
    </p>

    <a class="hero__scroll" href="#invitatie" data-hero-fade>
      <span>{hero.scrollHint}</span>
      <i aria-hidden="true"></i>
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 100svh;
    min-height: 34rem;
    background: var(--night);
    color: var(--ivory);
  }
  /* Pin mai scurt pe mobil (mai puțin „scroll gol" cu degetul). svh = stabil cu bara de adresă. */
  :global(.motion-ok) .hero {
    height: 200vh;
    height: 200svh;
  }
  @media (min-width: 1024px) {
    :global(.motion-ok) .hero {
      height: 230svh;
    }
  }
  .hero__sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    min-height: 34rem;
    overflow: hidden;
    display: grid;
  }
  .hero__frame {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--night);
  }
  .hero__media {
    position: absolute;
    inset: 0;
    transform-origin: 50% 45%;
  }
  /* Straturi proprii pe GPU (iOS Safari nu le promovează singur pentru transform-uri 2D):
     poza și titlul nu se mai re-randează la fiecare frame de scroll. */
  :global(.motion-ok) .hero__media,
  :global(.motion-ok) .hero__title {
    will-change: transform;
    backface-visibility: hidden;
  }
  .hero__media :global(.hero__pic),
  .hero__media :global(.hero__img) {
    width: 100%;
    height: 100%;
  }
  .hero__media :global(.hero__img) {
    object-fit: cover;
    object-position: 50% 30%;
    background-color: var(--night);
  }
  @media (min-width: 768px) {
    .hero__media :global(.hero__img) {
      object-position: 30% 50%;
    }
  }
  .hero__shade {
    position: absolute;
    inset: 0;
    /* Doar cât să se citească header-ul (sus) și data (jos); poza rămâne luminoasă. */
    background:
      linear-gradient(to top, rgb(14 13 10 / 0.78) 0%, rgb(14 13 10 / 0.3) 24%, transparent 42%),
      linear-gradient(to bottom, rgb(14 13 10 / 0.5), transparent 18%);
  }

  /* ── Numele: pe plic (cu animații) sau peste poză (fără) ─────────────── */
  .hero__content {
    position: absolute;
    z-index: 4;
    left: 0;
    right: 0;
    bottom: 50%;
    padding: 0 var(--gutter) clamp(2.5rem, 7svh, 4.5rem);
    display: grid;
    justify-items: center;
    gap: clamp(1rem, 3svh, 1.6rem);
    text-align: center;
  }
  .hero__eyebrow {
    color: var(--amber-soft);
  }
  .hero__title {
    font-size: clamp(2.6rem, 11.5vw, 6.5rem);
    font-style: italic;
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .hero__visual {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    column-gap: 0.28em;
  }
  .hero__name {
    display: block;
    padding-inline: 0.04em;
  }
  .hero__amp {
    display: block;
    font-size: 0.9em;
    line-height: 1;
  }
  .hero__date {
    position: absolute;
    z-index: 4;
    left: 0;
    right: 0;
    top: calc(58% + clamp(3.5rem, 8svh, 4.75rem));
    padding-inline: var(--gutter);
    text-align: center;
    font-family: var(--sans);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--on-dark-soft);
  }
  /* Fără animații nu există plic: textul stă peste poză, cu umbră pentru lizibilitate. */
  :global(html:not(.motion-ok)) .hero__content,
  :global(html:not(.motion-ok)) .hero__date {
    text-shadow: 0 2px 24px rgb(14 13 10 / 0.6);
  }

  /* ── Plicul ─────────────────────────────────────────────────────────── */
  .env {
    display: none;
  }
  :global(.motion-ok) .env {
    display: block;
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    perspective: 1400px;
  }
  .env__flap {
    position: absolute;
    inset: 0;
    will-change: transform;
    backface-visibility: hidden;
  }
  .env__flap svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .env__flap polygon {
    stroke: rgb(200 146 74 / 0.55);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    stroke-linejoin: round;
  }
  .env__flap--l polygon,
  .env__flap--r polygon {
    fill: #1a2418;
  }
  /* Umbre fine: clapele par suprapuse, iar când ies din ecran își poartă umbra peste poză. */
  .env__flap--l {
    filter: drop-shadow(4px 0 10px rgb(0 0 0 / 0.28));
  }
  .env__flap--r {
    filter: drop-shadow(-4px 0 10px rgb(0 0 0 / 0.28));
  }
  .env__flap--b {
    z-index: 1;
    filter: drop-shadow(0 -4px 12px rgb(0 0 0 / 0.3));
  }
  .env__flap--b polygon {
    fill: #1e291c;
  }
  .env__flap--t {
    z-index: 2;
    transform-origin: 50% 0;
    filter: drop-shadow(0 10px 18px rgb(0 0 0 / 0.35));
  }
  .env__flap--t polygon {
    fill: #253223;
  }
  .env__seal {
    position: absolute;
    z-index: 3;
    left: 50%;
    top: 58%;
    width: clamp(4.75rem, 20vw, 6.5rem);
    aspect-ratio: 1;
    margin: calc(clamp(4.75rem, 20vw, 6.5rem) / -2) 0 0 calc(clamp(4.75rem, 20vw, 6.5rem) / -2);
    will-change: transform, opacity;
  }
  .env__seal-shadow,
  .env__seal-half {
    position: absolute;
    inset: 0;
    border-radius: 47% 53% 50% 50% / 52% 48% 52% 48%;
  }
  .env__seal-shadow {
    box-shadow: 0 6px 16px rgb(0 0 0 / 0.4);
  }
  .env__seal-half {
    display: grid;
    place-items: center;
    background: radial-gradient(circle at 38% 32%, #d9a463 0%, #b0763a 45%, #8a5527 100%);
    box-shadow:
      inset 0 0 0 5px rgb(0 0 0 / 0.08),
      inset 0 0 0 9px rgb(255 230 190 / 0.12);
    will-change: transform, opacity;
  }
  /* Linia de crăpătură (zimțată) dintre cele două jumătăți ale sigiliului. */
  .env__seal-half--l {
    clip-path: polygon(0 0, 53% 0, 47% 24%, 55% 46%, 46% 70%, 52% 100%, 0 100%);
  }
  .env__seal-half--r {
    clip-path: polygon(53% 0, 100% 0, 100% 100%, 52% 100%, 46% 70%, 55% 46%, 47% 24%);
  }
  .env__seal-mono {
    display: flex;
    gap: 0;
    align-items: baseline;
    font-family: var(--script);
    font-size: clamp(1.9rem, 8vw, 2.6rem);
    line-height: 1;
    color: #5e3816;
    text-shadow: 0 1px 0 rgb(255 225 180 / 0.35);
  }
  .env__seal-amp {
    margin-inline: -0.06em;
    font-size: 0.8em;
  }
  @media (min-width: 1024px) {
    .env__seal,
    .env__seal-mono {
      font-size: 2.8rem;
    }
    .env__seal {
      width: 7rem;
      margin: -3.5rem 0 0 -3.5rem;
    }
  }

  .hero__caption {
    position: absolute;
    z-index: 4;
    left: 0;
    right: 0;
    bottom: calc(var(--seam) + 1.25rem);
    text-align: center;
    opacity: 0;
    font-family: var(--serif);
    font-size: clamp(1.1rem, 2.2vw, 1.5rem);
    letter-spacing: 0.3em;
    color: var(--amber-soft);
  }

  .hero__scroll {
    position: absolute;
    z-index: 4;
    left: 50%;
    bottom: calc(1.25rem + env(safe-area-inset-bottom));
    translate: -50% 0;
    display: grid;
    justify-items: center;
    gap: 0.6rem;
    min-width: 44px;
    padding: 0.25rem 0.5rem;
    font-size: 0.6875rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--on-dark-soft);
  }
  .hero__scroll i {
    position: relative;
    width: 1px;
    height: 2.75rem;
    background: rgb(244 237 225 / 0.2);
    overflow: hidden;
  }
  .hero__scroll i::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--amber);
    transform: translateY(-100%);
    animation: scroll-line 2.2s var(--ease-in-out) infinite;
  }
  @keyframes scroll-line {
    0% {
      transform: translateY(-100%);
    }
    55% {
      transform: translateY(0);
    }
    100% {
      transform: translateY(100%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__scroll i::after {
      animation: none;
      transform: none;
    }
  }

  /* Măștile SplitText: puțin spațiu pentru diacritice (ș) și înclinarea italicului. */
  :global(.hero__name > div) {
    padding: 0.08em 0.1em 0.2em;
    margin: -0.08em -0.1em -0.2em;
  }

  /* Intro (doar cu JS): numele sunt ascunse până la SplitText. */
  :global(.js.motion-ok) .hero__visual:not(.is-ready) {
    opacity: 0;
  }
</style>
