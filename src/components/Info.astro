---
import { info } from '../data/wedding';
---

<section class="info on-ivory section" id="info" aria-labelledby="info-title">
  <div class="container info__grid">
    <header>
      <p class="kicker" data-reveal>{info.kicker}</p>
      <h2 class="h2" id="info-title" data-reveal style="--d:80">{info.title}</h2>
    </header>
    <div class="info__list">
      {
        info.items.map((it, i) => (
          <details class="acc" data-reveal style={`--d:${i * 70}`} name="info">
            <summary class="acc__sum">
              <span class="acc__q">{it.q}</span>
              <span class="acc__icon" aria-hidden="true" />
            </summary>
            <div class="acc__body">
              <p>{it.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .info__grid {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
  }
  @media (min-width: 960px) {
    .info__grid {
      grid-template-columns: 0.8fr 1.2fr;
      align-items: start;
    }
  }
  .info__list {
    border-top: 1px solid rgb(31 42 30 / 0.18);
  }
  .acc {
    border-bottom: 1px solid rgb(31 42 30 / 0.18);
    interpolate-size: allow-keywords;
  }
  .acc::details-content {
    block-size: 0;
    overflow: clip;
    transition:
      block-size 0.5s var(--ease-out),
      content-visibility 0.5s allow-discrete;
  }
  .acc[open]::details-content {
    block-size: auto;
  }
  .acc__sum {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4.5rem;
    padding-block: 1rem;
    cursor: pointer;
    list-style: none;
    -webkit-tap-highlight-color: transparent;
  }
  .acc__sum::-webkit-details-marker {
    display: none;
  }
  .acc__q {
    font-family: var(--serif);
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    line-height: 1.1;
    color: var(--night);
    transition: transform 0.4s var(--ease-out);
  }
  @media (hover: hover) {
    .acc__sum:hover .acc__q {
      transform: translateX(6px);
    }
  }
  .acc__icon {
    position: relative;
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgb(31 42 30 / 0.25);
    transition:
      background-color 0.35s,
      transform 0.5s var(--ease-out);
  }
  .acc__icon::before,
  .acc__icon::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 14px;
    height: 1.5px;
    margin: -0.75px 0 0 -7px;
    background: var(--forest);
    transition: transform 0.5s var(--ease-out);
  }
  .acc__icon::after {
    transform: rotate(90deg);
  }
  .acc[open] .acc__icon {
    background: var(--forest);
    transform: rotate(180deg);
  }
  .acc[open] .acc__icon::before,
  .acc[open] .acc__icon::after {
    background: var(--ivory);
  }
  .acc[open] .acc__icon::after {
    transform: rotate(0deg);
  }
  .acc__body {
    padding: 0 3.5rem 1.75rem 0;
    color: var(--ink-soft);
    max-width: 40rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .acc::details-content {
      transition: none;
    }
  }
</style>
