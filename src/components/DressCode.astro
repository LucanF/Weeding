---
import { dressCode } from '../data/wedding';
---

<section class="dc on-ivory section" id="dress-code" aria-labelledby="dc-title">
  <div class="container dc__inner">
    <div class="dc__text">
      <p class="kicker" data-reveal>{dressCode.kicker}</p>
      <h2 class="h2" id="dc-title" data-reveal style="--d:80">{dressCode.title}</h2>
      <p class="lead dc__lead" data-reveal style="--d:160">{dressCode.text}</p>
      <p class="dc__avoid" data-reveal style="--d:220">
        <span class="dc__x" aria-hidden="true"></span>
        {dressCode.avoid}
      </p>
    </div>
    <ul class="dc__swatches" role="list" aria-label="Paleta de culori sugerată">
      {
        dressCode.colors.map((c, i) => (
          <li class="dc__sw" data-reveal style={`--d:${i * 110};--c:${c.hex}`}>
            <span class="dc__chip" aria-hidden="true" />
            <span class="dc__name">{c.name}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .dc {
    padding-top: clamp(4rem, 10vw, 8rem);
  }
  .dc__inner {
    display: grid;
    gap: clamp(3rem, 7vw, 5rem);
  }
  .dc__lead {
    margin-top: 1.5rem;
  }
  .dc__avoid {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--ivory);
  }
  .dc__x {
    position: relative;
    width: 22px;
    height: 28px;
    border-radius: 11px 11px 4px 4px;
    background: transparent;
    border: 1px solid rgb(201 165 90 / 0.45);
    overflow: hidden;
  }
  .dc__x::after {
    content: '';
    position: absolute;
    left: 50%;
    top: -4px;
    bottom: -4px;
    width: 1.5px;
    background: var(--terracotta);
    transform: rotate(38deg);
  }
  .dc__swatches {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(0.6rem, 2vw, 1.5rem);
    padding: 0;
    align-items: end;
  }
  .dc__sw {
    display: grid;
    justify-items: center;
    gap: 0.85rem;
    text-align: center;
  }
  .dc__sw:nth-child(even) {
    margin-bottom: 2rem;
  }
  .dc__chip {
    width: 100%;
    aspect-ratio: 1 / 2.1;
    border-radius: 999px 999px 0.75rem 0.75rem;
    background:
      linear-gradient(160deg, rgb(255 255 255 / 0.18), transparent 45%),
      var(--c);
    box-shadow:
      inset 0 0 0 1px rgb(201 165 90 / 0.45),
      0 22px 40px -22px var(--c);
    transition: transform 0.6s var(--ease-out);
  }
  @media (hover: hover) {
    .dc__sw:hover .dc__chip {
      transform: translateY(-8px);
    }
  }
  .dc__name {
    font-size: clamp(0.6875rem, 1.6vw, 0.8125rem);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.04em;
    color: var(--ivory);
  }
  @media (min-width: 960px) {
    .dc__inner {
      grid-template-columns: 1fr 1.1fr;
      align-items: center;
    }
  }
</style>
