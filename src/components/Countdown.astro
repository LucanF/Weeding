---
import ThreadLine from './ui/ThreadLine.astro';
import { countdown, date, events } from '../data/wedding';

const toGcal = (iso: string) => new Date(iso).toISOString().replace(/[-:]/g, '').replace(/\.\d{3}/, '');
const site = Astro.site ?? new URL(Astro.url.origin);
const location = `${events.items[0].place}, ${events.items[0].address}`;
const gcal = new URL('https://calendar.google.com/calendar/render');
gcal.searchParams.set('action', 'TEMPLATE');
gcal.searchParams.set('text', countdown.calendarTitle);
gcal.searchParams.set('dates', `${toGcal(date.start)}/${toGcal(date.end)}`);
gcal.searchParams.set('details', countdown.calendarDetails + site.href);
gcal.searchParams.set('location', location);
gcal.searchParams.set('ctz', date.timeZone);

const units = ['days', 'hours', 'minutes', 'seconds'] as const;
---

<section class="cd on-ivory" id="countdown" aria-labelledby="cd-title" data-countdown data-target={date.start}>
  <div class="container cd__inner">
    <p class="kicker kicker--center" data-reveal>{countdown.kicker}</p>
    <h2 class="h2 cd__title" id="cd-title" data-reveal style="--d:80">{countdown.title}</h2>

    <p class="cd__fallback">{date.long}</p>

    <div class="cd__grid" aria-hidden="true" data-cd-grid data-reveal style="--d:160">
      {
        units.map((u, i) => (
          <>
            {i > 0 && <span class="cd__sep">·</span>}
            <div class="cd__unit">
              <span class="cd__num" data-cd={u}>
                00
              </span>
              <span class="cd__label">{countdown.units[u]}</span>
            </div>
          </>
        ))
      }
    </div>
    <p class="sr-only" data-cd-sr></p>

    <div class="cd__done" data-cd-done hidden>
      <p class="cd__done-title">{countdown.done}</p>
      <p class="lead">{countdown.doneSub}</p>
    </div>

    <div class="cd__cal" data-reveal style="--d:240">
      <p class="cd__cal-label">{countdown.addToCalendar}</p>
      <div class="cd__cal-btns">
        <a class="btn btn--dark" href={gcal.href} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"
            ><rect x="3.5" y="5" width="17" height="15" rx="2"></rect><path d="M3.5 10h17M8 3v4M16 3v4"></path></svg
          >
          {countdown.google}
        </a>
        <a class="btn btn--ghost" href={countdown.icsFile} download>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"
            ><path d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 19.5h14"></path></svg
          >
          {countdown.ics}
        </a>
      </div>
    </div>
  </div>
  <ThreadLine height="clamp(8rem, 20vh, 12rem)" />
</section>

<style>
  .cd {
    padding-top: clamp(3rem, 8vw, 6rem);
    /* loc pentru arcul cu care urcă „Povestea"; firul auriu se termină exact în vârful arcului */
    padding-bottom: var(--seam);
  }
  .cd__inner {
    display: grid;
    justify-items: center;
    text-align: center;
    padding-bottom: clamp(3rem, 8vw, 5rem);
  }
  .cd__fallback {
    margin-top: 2rem;
    font-family: var(--serif);
    font-size: var(--fs-h3);
    font-style: italic;
  }
  :global(.js) .cd__fallback {
    display: none;
  }
  .cd__grid {
    display: none;
    margin-top: clamp(2.5rem, 6vw, 4rem);
    grid-template-columns: repeat(2, auto);
    gap: 2.25rem 3rem;
    color: var(--forest);
  }
  :global(.js) .cd__grid {
    display: grid;
  }
  .cd__grid[hidden] {
    display: none !important;
  }
  .cd__sep {
    display: none;
  }
  .cd__unit {
    display: grid;
    justify-items: center;
    gap: 0.6rem;
  }
  .cd__num {
    display: inline-flex;
    font-family: var(--sans);
    font-size: clamp(4.25rem, 12vw, 8.5rem);
    line-height: 0.9;
    font-variant-numeric: lining-nums tabular-nums;
    font-feature-settings: 'lnum' 1, 'tnum' 1;
    letter-spacing: -0.01em;
  }
  .cd__num :global(.dg) {
    position: relative;
    display: inline-block;
    overflow: hidden;
    height: 1em;
    padding: 0.04em 0.08em 0;
    margin-inline: -0.04em;
    box-sizing: content-box;
  }
  .cd__num :global(.dg span) {
    display: block;
    height: 1em;
    line-height: 1;
    text-align: center;
  }
  .cd__num :global(.dg.is-rolling span) {
    animation: roll 0.7s var(--ease-out) both;
  }
  @keyframes roll {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(-100%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cd__num :global(.dg.is-rolling span) {
      animation-duration: 1ms;
    }
  }
  .cd__label {
    font-size: var(--fs-kicker);
    font-weight: 600;
    color: var(--moss);
  }
  @media (min-width: 768px) {
    .cd__grid {
      grid-template-columns: repeat(7, auto);
      align-items: start;
      gap: 0 clamp(1rem, 2.5vw, 2.5rem);
    }
    .cd__sep {
      display: block;
      font-family: var(--sans);
      font-size: clamp(3rem, 6vw, 5rem);
      line-height: 1.2;
      color: var(--amber);
    }
  }
  .cd__done {
    margin-top: 2.5rem;
    display: grid;
    justify-items: center;
    gap: 1rem;
  }
  .cd__done-title {
    font-family: var(--serif);
    font-style: italic;
    font-size: var(--fs-display);
    line-height: 1;
    color: var(--forest);
  }
  .cd__cal {
    margin-top: clamp(3rem, 7vw, 4.5rem);
    display: grid;
    justify-items: center;
    gap: 1.1rem;
  }
  .cd__cal-label {
    font-size: var(--fs-small);
    color: var(--ink-soft);
  }
  .cd__cal-btns {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }
</style>
