---
import { getImage } from 'astro:assets';
import Img from './ui/Img.astro';
import { gallery } from '../data/wedding';
import { photos, galleryOrder } from '../data/photos';

const items = await Promise.all(
  galleryOrder.map(async (key, index) => {
    const p = photos[key];
    // Lightbox: srcset (telefon ~1080px, desktop/retina mare ~1800px), încărcat doar la deschidere.
    const w = Math.min(1800, p.src.width);
    const ws = [...new Set([1080, 1800].map((x) => Math.min(x, p.src.width)))];
    const set = async (format: 'avif' | 'webp' | 'jpg') => {
      const imgs = await Promise.all(
        ws.map((x) => getImage({ src: p.src, width: x, format, quality: format === 'avif' ? 55 : 76 })),
      );
      return { srcset: imgs.map((r, i) => `${r.src} ${ws[i]}w`).join(', '), src: imgs[imgs.length - 1].src };
    };
    const [avif, webp, jpg] = await Promise.all([set('avif'), set('webp'), set('jpg')]);
    return {
      key,
      index,
      p,
      avif: avif.srcset,
      webp: webp.srcset,
      jpgSet: jpg.srcset,
      jpg: jpg.src,
      w,
      h: Math.round((p.src.height * w) / p.src.width),
    };
  }),
);
// Trei coloane pe desktop (parallax cu viteze diferite); pe mobil devin un carusel.
const cols = [0, 1, 2].map((c) => items.filter((_, i) => i % 3 === c));
const speeds = [-8, 10, -4];
---

<section class="gal on-dark grain" id="galerie" aria-labelledby="gal-title" data-gallery>
  <div class="container gal__head">
    <p class="kicker" data-reveal>{gallery.kicker}</p>
    <h2 class="h2" id="gal-title" data-reveal style="--d:80">{gallery.title}</h2>
    <p class="gal__hint" data-reveal style="--d:160">{gallery.hint}</p>
  </div>

  <div class="gal__grid" data-gal-track>
    {
      cols.map((col, ci) => (
        <div class="gal__col" data-speed={speeds[ci]}>
          {col.map((it) => (
            <button
              type="button"
              class:list={['gal__item', `gal__item--${it.key}`]}
              data-gal-item={it.index}
              data-avif={it.avif}
              data-webp={it.webp}
              data-jpg={it.jpg}
              data-jpgset={it.jpgSet}
              data-w={it.w}
              data-h={it.h}
              data-alt={it.p.alt}
              aria-label={`Mărește fotografia: ${it.p.alt}`}
              style={`order:${it.index}`}
            >
              <Img
                src={it.p.src}
                alt=""
                widths={[480, 720, 960]}
                sizes="(min-width: 960px) 30vw, 78vw"
                lqip={it.p.lqip}
                class="gal__pic"
                imgClass="gal__img"
              />
              <span class="gal__zoom" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M14 4h6v6M10 20H4v-6M20 4l-6.5 6.5M4 20l6.5-6.5" />
                </svg>
              </span>
            </button>
          ))}
        </div>
      ))
    }
  </div>
  <div class="gal__dots" aria-hidden="true">
    {items.map((_, i) => <span class:list={['gal__dot', i === 0 && 'is-on']} />)}
  </div>

  <dialog class="lb" data-lightbox aria-label="Galerie foto">
    <div class="lb__bar">
      <p class="lb__count" data-lb-count>1 / {items.length}</p>
      <button type="button" class="lb__btn lb__close" data-lb-close>
        <span class="sr-only">{gallery.close}</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
      </button>
    </div>
    <figure class="lb__fig" data-lb-fig>
      <picture>
        <source type="image/avif" data-lb-avif sizes="(min-width: 960px) calc(100vw - 14rem), 100vw" />
        <source type="image/webp" data-lb-webp sizes="(min-width: 960px) calc(100vw - 14rem), 100vw" />
        <img
          class="lb__img"
          alt=""
          data-lb-img
          decoding="async"
          sizes="(min-width: 960px) calc(100vw - 14rem), 100vw"
        />
      </picture>
      <figcaption class="lb__cap" data-lb-cap></figcaption>
    </figure>
    <button type="button" class="lb__btn lb__nav lb__prev" data-lb-prev>
      <span class="sr-only">{gallery.prev}</span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
    </button>
    <button type="button" class="lb__btn lb__nav lb__next" data-lb-next>
      <span class="sr-only">{gallery.next}</span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
    </button>
  </dialog>
</section>

<style>
  .gal {
    position: relative;
    padding-block: var(--section-y);
    overflow: clip;
    background:
      radial-gradient(60% 40% at 80% 0%, rgb(160 98 78 / 0.16), transparent 70%),
      var(--night);
  }
  .gal__hint {
    margin-top: 1rem;
    font-size: var(--fs-small);
    color: var(--on-dark-soft);
  }
  .gal__grid {
    display: flex;
    gap: 0.9rem;
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
    padding: 0 var(--gutter) 0.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .gal__grid::-webkit-scrollbar {
    display: none;
  }
  .gal__col {
    display: contents;
  }
  .gal__item {
    position: relative;
    flex: none;
    width: 78vw;
    max-width: 24rem;
    aspect-ratio: 4 / 5;
    padding: 0;
    border: 0;
    border-radius: 999px 999px 1rem 1rem;
    overflow: hidden;
    background: var(--night-2);
    scroll-snap-align: start;
    -webkit-tap-highlight-color: transparent;
  }
  .gal__item :global(.gal__pic),
  .gal__item :global(.gal__img) {
    width: 100%;
    height: 100%;
  }
  .gal__item :global(.gal__img) {
    object-fit: cover;
    background-size: cover;
    transition: transform 1.2s var(--ease-out);
  }
  .gal__item--portret :global(.gal__img) {
    object-position: 66% 50%;
  }
  .gal__item--arcada :global(.gal__img) {
    object-position: 34% 50%;
  }
  .gal__zoom {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgb(14 13 10 / 0.55);
    color: var(--ivory);
    opacity: 0.9;
    transition:
      opacity 0.4s,
      transform 0.5s var(--ease-out);
  }
  .gal__zoom svg {
    width: 18px;
    height: 18px;
  }
  @media (hover: hover) {
    .gal__item:hover :global(.gal__img) {
      transform: scale(1.05);
    }
    .gal__item:not(:hover) .gal__zoom {
      opacity: 0;
      transform: scale(0.8);
    }
  }
  .gal__item:focus-visible {
    outline-offset: 4px;
  }
  .gal__dots {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }
  .gal__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgb(244 237 225 / 0.25);
    transition:
      background-color 0.3s,
      transform 0.3s;
  }
  .gal__dot.is-on {
    background: var(--amber);
    transform: scale(1.3);
  }

  @media (min-width: 960px) {
    .gal__grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(1.25rem, 2.5vw, 2.5rem);
      width: min(100% - 2 * var(--gutter), 80rem);
      margin-inline: auto;
      padding: 0;
      overflow: visible;
    }
    .gal__col {
      display: grid;
      gap: clamp(1.25rem, 2.5vw, 2.5rem);
      align-content: start;
    }
    .gal__col:nth-child(2) {
      padding-top: 8rem;
    }
    .gal__col:nth-child(3) {
      padding-top: 3rem;
    }
    .gal__item {
      width: 100%;
      max-width: none;
      order: 0 !important;
    }
    .gal__col:nth-child(1) .gal__item:first-child,
    .gal__col:nth-child(3) .gal__item:last-child {
      aspect-ratio: 3 / 4;
    }
    .gal__col:nth-child(2) .gal__item:first-child {
      aspect-ratio: 4 / 5.6;
    }
    .gal__dots {
      display: none;
    }
  }

  /* ── Lightbox ─────────────────────────────────────────────────────── */
  .lb {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(14 13 10 / 0.96);
    color: var(--ivory);
    overflow: hidden;
    overscroll-behavior: contain;
  }
  .lb[open] {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    animation: lb-in 0.45s var(--ease-out);
  }
  .lb::backdrop {
    background: rgb(14 13 10 / 0.7);
  }
  @keyframes lb-in {
    from {
      opacity: 0;
    }
  }
  .lb__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: calc(0.75rem + env(safe-area-inset-top)) var(--gutter) 0.75rem;
  }
  .lb__count {
    font-size: var(--fs-small);
    letter-spacing: 0.2em;
    color: var(--on-dark-soft);
    font-variant-numeric: tabular-nums;
  }
  .lb__btn {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid rgb(244 237 225 / 0.25);
    border-radius: 50%;
    background: rgb(14 13 10 / 0.5);
    color: var(--ivory);
    transition:
      background-color 0.3s,
      transform 0.3s var(--ease-out);
  }
  .lb__btn:hover {
    background: rgb(200 146 74 / 0.25);
  }
  .lb__btn:active {
    transform: scale(0.94);
  }
  .lb__btn svg {
    width: 22px;
    height: 22px;
  }
  .lb__fig {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    place-items: center;
    min-height: 0;
    padding: 0 var(--gutter) calc(5.5rem + env(safe-area-inset-bottom));
    touch-action: pan-y pinch-zoom;
  }
  .lb__fig picture {
    min-height: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .lb__img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 0.5rem;
    transition:
      opacity 0.35s var(--ease-out),
      transform 0.45s var(--ease-out);
  }
  .lb__img.is-swapping {
    opacity: 0;
    transform: scale(0.98);
  }
  .lb__cap {
    margin-top: 1rem;
    max-width: 40rem;
    text-align: center;
    font-size: var(--fs-small);
    color: var(--on-dark-soft);
  }
  .lb__nav {
    position: absolute;
    bottom: calc(1.25rem + env(safe-area-inset-bottom));
  }
  .lb__prev {
    left: calc(50% - 60px);
  }
  .lb__next {
    left: calc(50% + 12px);
  }
  @media (min-width: 960px) {
    .lb__fig {
      padding: 0 7rem 3rem;
    }
    .lb__nav {
      bottom: auto;
      top: 50%;
      translate: 0 -50%;
    }
    .lb__prev {
      left: 2rem;
    }
    .lb__next {
      left: auto;
      right: 2rem;
    }
  }
</style>
