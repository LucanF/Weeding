---
import Img from './ui/Img.astro';
import { rsvp } from '../data/wedding';
import { photos, crops } from '../data/photos';

const wa = `https://wa.me/${rsvp.whatsappNumber}?text=${encodeURIComponent(rsvp.whatsappMessage)}`;
const f = rsvp.fields;
---

<section class="rsvp" id="rsvp" aria-labelledby="rsvp-title" data-rsvp>
  <div class="rsvp__bg vignette" aria-hidden="true">
    <div class="rsvp__media" data-rsvp-media>
      <Img
        src={photos.intim.src}
        mobile={crops.rsvpMobile}
        alt=""
        widths={[960, 1440, 2048]}
        sizes="100vw"
        mobileWidths={[480, 720, 956]}
        lqip={photos.intim.lqip}
        class="rsvp__pic"
        imgClass="rsvp__img"
      />
    </div>
  </div>

  <div class="container rsvp__head">
    <p class="kicker" data-reveal>{rsvp.kicker}</p>
    <h2 class="h2 rsvp__title" id="rsvp-title" data-reveal style="--d:80">{rsvp.title}</h2>
    <p class="rsvp__intro" data-reveal style="--d:160">{rsvp.intro}</p>
  </div>

  <div class="rsvp__panel on-ivory" data-rsvp-panel>
    <p class="rsvp__please" aria-hidden="true">Răspundeți, vă rog</p>
    <form
      class="form"
      name={rsvp.formName}
      method="POST"
      action="/multumim/"
      data-netlify="true"
      netlify-honeypot="bot-field"
      data-rsvp-form
      novalidate
    >
      <input type="hidden" name="form-name" value={rsvp.formName} />
      <p class="form__hp" aria-hidden="true">
        <label>Nu completați acest câmp: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
      </p>

      <div class="field">
        <label class="field__label" for="f-name">{f.name}</label>
        <input
          class="field__input"
          id="f-name"
          name="nume"
          type="text"
          autocomplete="name"
          required
          maxlength="120"
          placeholder={f.namePh}
          aria-describedby="f-name-err"
        />
        <p class="field__err" id="f-name-err" data-err-for="nume" hidden>{rsvp.errors.name}</p>
      </div>

      <fieldset class="field choice" aria-describedby="f-att-err">
        <legend class="field__label">{f.attending}</legend>
        <div class="choice__opts">
          <label class="choice__opt">
            <input type="radio" name="prezenta" value="da" required />
            <span class="choice__box">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>
              {f.yes}
            </span>
          </label>
          <label class="choice__opt">
            <input type="radio" name="prezenta" value="nu" />
            <span class="choice__box">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M7 7l10 10M17 7 7 17"></path></svg>
              {f.no}
            </span>
          </label>
        </div>
        <p class="field__err" id="f-att-err" data-err-for="prezenta" hidden>{rsvp.errors.attending}</p>
      </fieldset>

      <div class="form__more" data-if-yes>
        <div class="form__row">
          <div class="field">
            <label class="field__label" for="f-guests">{f.guests}</label>
            <div class="field__select">
              <select class="field__input" id="f-guests" name="persoane">
                {[1, 2, 3, 4, 5, 6].map((n) => <option value={n}>{n}</option>)}
              </select>
            </div>
          </div>
          <div class="field">
            <label class="field__label" for="f-menu">{f.menu}</label>
            <div class="field__select">
              <select class="field__input" id="f-menu" name="meniu">
                {f.menuOptions.map((m) => <option value={m}>{m}</option>)}
              </select>
            </div>
          </div>
        </div>
        <div class="field">
          <label class="field__label" for="f-allergies">{f.allergies}</label>
          <input class="field__input" id="f-allergies" name="alergii" type="text" maxlength="200" placeholder={f.allergiesPh} />
        </div>
      </div>

      <div class="field">
        <label class="field__label" for="f-msg">{f.message}</label>
        <textarea class="field__input field__area" id="f-msg" name="mesaj" rows="3" maxlength="1000" placeholder={f.messagePh}></textarea>
      </div>

      <p class="form__error" role="alert" data-form-error hidden>{rsvp.errors.generic}</p>

      <button class="btn form__submit" type="submit" data-submit data-label={rsvp.submit} data-sending={rsvp.sending}>
        <span data-submit-label>{rsvp.submit}</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 12h15m-5-5 5 5-5 5"></path></svg>
      </button>
    </form>

    <div class="success" data-rsvp-success hidden tabindex="-1">
      <svg class="success__mark" viewBox="0 0 120 140" aria-hidden="true">
        <path class="thread" pathLength="1" d="M10 140 V60 a50 50 0 0 1 100 0 V140"></path>
        <path class="success__check" pathLength="1" d="M40 82 l14 14 l28 -30"></path>
      </svg>
      <p class="success__title">{rsvp.successTitle}</p>
      <p class="success__text" data-success-yes>{rsvp.successYes}</p>
      <p class="success__text" data-success-no hidden>{rsvp.successNo}</p>
    </div>

    <div class="rsvp__or"><span>{rsvp.or}</span></div>
    <a class="btn btn--wa rsvp__wa" href={wa} target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
        ><path
          d="M12 2.2A9.8 9.8 0 0 0 3.6 17l-1.3 4.8 4.9-1.3A9.8 9.8 0 1 0 12 2.2Zm0 17.9a8.1 8.1 0 0 1-4.1-1.1l-.3-.2-2.9.8.8-2.8-.2-.3A8.1 8.1 0 1 1 12 20.1Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.6 6.6 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.9 11.9 0 0 0 4.6 4c1.7.7 2.3.8 3.2.7.5-.1 1.5-.6 1.7-1.2s.2-1.1.2-1.2-.2-.2-.4-.3Z"
        ></path></svg
      >
      {rsvp.whatsapp}
    </a>
  </div>
</section>

<style>
  .rsvp {
    position: relative;
    isolation: isolate;
    background: var(--night);
    color: var(--ivory);
    padding-bottom: clamp(4rem, 10vw, 8rem);
  }
  .rsvp__bg {
    position: relative;
    height: clamp(30rem, 92svh, 56rem);
    overflow: hidden;
    background: #2a1a12;
  }
  .rsvp__media {
    position: absolute;
    inset: -8% 0;
  }
  .rsvp__media :global(.rsvp__pic),
  .rsvp__media :global(.rsvp__img) {
    width: 100%;
    height: 100%;
  }
  .rsvp__media :global(.rsvp__img) {
    object-fit: cover;
    object-position: 50% 22%;
    background-size: cover;
  }
  .rsvp__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgb(14 13 10 / 0.88) 0%, rgb(14 13 10 / 0.3) 38%, transparent 55%, rgb(14 13 10 / 0.9) 100%),
      rgb(160 98 78 / 0.12);
  }
  .rsvp__head {
    position: absolute;
    top: clamp(5rem, 12vw, 9rem);
    left: 0;
    right: 0;
    z-index: 2;
  }
  .rsvp__title {
    max-width: 9em;
  }
  .rsvp__intro {
    margin-top: 1.25rem;
    max-width: 28rem;
    color: var(--on-dark-soft);
  }

  .rsvp__panel {
    position: relative;
    z-index: 2;
    width: min(100% - 2 * clamp(0.75rem, 3vw, 2rem), 44rem);
    margin: clamp(-14rem, -30svh, -9rem) auto 0;
    padding: 6rem clamp(1.25rem, 6vw, 4rem) clamp(2rem, 6vw, 3.5rem);
    border-radius: 50% 50% 1.5rem 1.5rem / 10rem 10rem 1.5rem 1.5rem;
    box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.6);
  }
  :global(.motion-ok) .rsvp__panel {
    will-change: transform;
  }
  @media (max-width: 600px) {
    .rsvp__panel {
      border-radius: 50% 50% 1.25rem 1.25rem / 7rem 7rem 1.25rem 1.25rem;
      padding-top: 5.5rem;
    }
  }
  .rsvp__panel::before {
    content: '';
    position: absolute;
    inset: 10px;
    border: 1px solid rgb(200 146 74 / 0.4);
    border-radius: inherit;
    pointer-events: none;
  }

  .rsvp__please {
    position: absolute;
    top: 2.6rem;
    left: 0;
    right: 0;
    text-align: center;
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.5rem;
    color: var(--terracotta);
  }
  @media (max-width: 600px) {
    .rsvp__please {
      top: 2.4rem;
    }
  }

  /* ── Formular ──────────────────────────────────────────────────────── */
  .form {
    display: grid;
    gap: 1.75rem;
  }
  .form__hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .field {
    display: grid;
    gap: 0.45rem;
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }
  .field__label {
    padding: 0;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--forest);
  }
  .field__input {
    width: 100%;
    min-height: 48px;
    padding: 0.6rem 0.1rem;
    border: 0;
    border-bottom: 1px solid rgb(31 42 30 / 0.35);
    border-radius: 0;
    background: transparent;
    font-size: 1.0625rem;
    color: var(--night);
    transition: border-color 0.3s;
    appearance: none;
  }
  .field__input::placeholder {
    color: rgb(31 42 30 / 0.45);
  }
  .field__input:hover {
    border-bottom-color: var(--forest);
  }
  .field__input:focus-visible {
    outline: none;
    border-bottom-color: var(--forest);
    box-shadow: 0 2px 0 0 var(--forest);
  }
  .field__input[aria-invalid='true'] {
    border-bottom-color: #9b2c1f;
  }
  .field__area {
    resize: vertical;
    min-height: 5.5rem;
    line-height: 1.5;
  }
  .field__select {
    position: relative;
  }
  .field__select::after {
    content: '';
    position: absolute;
    right: 0.4rem;
    top: 50%;
    width: 8px;
    height: 8px;
    border-right: 1.5px solid var(--forest);
    border-bottom: 1.5px solid var(--forest);
    transform: translateY(-70%) rotate(45deg);
    pointer-events: none;
  }
  .field__select select {
    padding-right: 2rem;
    cursor: pointer;
  }
  .field__err,
  .form__error {
    font-size: var(--fs-small);
    font-weight: 600;
    color: #9b2c1f;
  }
  .form__row {
    display: grid;
    gap: 1.75rem;
  }
  @media (min-width: 600px) {
    .form__row {
      grid-template-columns: 1fr 1fr;
    }
  }
  .form__more {
    display: grid;
    gap: 1.75rem;
  }
  .form__more[hidden] {
    display: none;
  }

  .choice__opts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin-top: 0.4rem;
  }
  .choice__opt {
    position: relative;
    display: block;
  }
  .choice__opt input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }
  .choice__box {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 3.25rem;
    padding: 0.7rem 0.75rem;
    border: 1px solid rgb(31 42 30 / 0.3);
    border-radius: 1.6rem 1.6rem 0.6rem 0.6rem;
    font-weight: 600;
    font-size: 0.9375rem;
    text-align: center;
    color: var(--forest);
    transition:
      background-color 0.3s,
      color 0.3s,
      border-color 0.3s,
      transform 0.3s var(--ease-out);
  }
  .choice__box svg {
    width: 1.1rem;
    height: 1.1rem;
    flex: none;
    opacity: 0;
    transform: scale(0.5);
    transition:
      opacity 0.3s,
      transform 0.4s var(--ease-out);
  }
  @media (max-width: 420px) {
    .choice__box {
      font-size: 0.8125rem;
      padding-inline: 0.5rem;
      gap: 0.35rem;
    }
  }
  .choice__opt:hover .choice__box {
    border-color: var(--forest);
  }
  .choice__opt input:checked + .choice__box {
    background: var(--forest);
    border-color: var(--forest);
    color: var(--ivory);
  }
  .choice__opt input:checked + .choice__box svg {
    opacity: 1;
    transform: none;
  }
  .choice__opt input:focus-visible + .choice__box {
    outline: 2px solid var(--royal);
    outline-offset: 3px;
  }
  .choice__opt input:active + .choice__box {
    transform: scale(0.97);
  }
  .form__submit {
    justify-self: stretch;
    margin-top: 0.5rem;
    min-height: 3.5rem;
  }
  .form__submit[disabled] {
    opacity: 0.7;
    cursor: progress;
  }

  .success {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 0.75rem;
    padding-block: 1rem 0.5rem;
    outline: none;
  }
  .success[hidden] {
    display: none;
  }
  .success__mark {
    width: 84px;
    height: 98px;
    overflow: visible;
  }
  .success__mark .thread {
    stroke-width: 1.5;
  }
  .success__check {
    fill: none;
    stroke: var(--forest);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 0.9s 0.5s var(--ease-out) forwards;
  }
  .success__mark .thread {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 1.2s var(--ease-out) forwards;
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  .success__title {
    font-family: var(--serif);
    font-style: italic;
    font-size: var(--fs-h2);
    line-height: 1;
    color: var(--forest);
  }
  .success__text {
    color: var(--ink-soft);
    max-width: 24rem;
  }
  .rsvp__or {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-block: 1.75rem 1.25rem;
    font-size: var(--fs-kicker);
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--moss);
  }
  .rsvp__or::before,
  .rsvp__or::after {
    content: '';
    flex: 1;
    height: 1px;
    background: rgb(31 42 30 / 0.18);
  }
  .rsvp__wa {
    width: 100%;
  }
</style>
