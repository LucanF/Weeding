---
import Img from './ui/Img.astro';
import { rsvp } from '../data/wedding';
import { photos, crops } from '../data/photos';

const wa = `https://wa.me/${rsvp.whatsappNumber.replace(/\D/g, '')}?text=${encodeURIComponent(rsvp.whatsappMessage)}`;
const f = rsvp.fields;
const waCfg = JSON.stringify({
  number: rsvp.whatsappNumber,
  defaultMessage: rsvp.whatsappMessage,
  introYes: rsvp.whatsappIntroYes,
  introNo: rsvp.whatsappIntroNo,
  labels: rsvp.whatsappLabels,
  nameLabel: f.name,
  nameLabelN: f.nameN,
  namePh: f.namePh,
});
---

<section class="rsvp" id="rsvp" aria-labelledby="rsvp-title" data-rsvp>
  <div class="rsvp__bg vignette" aria-hidden="true">
    <div class="rsvp__media" data-rsvp-media>
      <Img
        src={photos.intim.src}
        mobile={crops.rsvpMobile}
        alt=""
        widths={[960, 1440, 2048]}
        sizes="100vw"
        mobileWidths={[480, 720, 956]}
        lqip={photos.intim.lqip}
        class="rsvp__pic"
        imgClass="rsvp__img"
      />
    </div>
  </div>

  <div class="container rsvp__head">
    <p class="kicker" data-ch data-reveal>{rsvp.kicker}</p>
    <h2 class="h2 rsvp__title" id="rsvp-title" data-reveal style="--d:80">{rsvp.title}</h2>
    <p class="rsvp__intro" data-reveal style="--d:160">{rsvp.intro}</p>
  </div>

  <div class="rsvp__panel on-ivory" data-rsvp-panel>
    <p class="rsvp__please" aria-hidden="true">Răspundeți, vă rog</p>
    <form class="form" aria-label="Confirmare prezență" data-rsvp-form data-wa={waCfg} novalidate>
      <div class="form__more" data-if-yes>
        <div class="field">
          <label class="field__label" for="f-guests">{f.guests}</label>
          <div class="field__select">
            <select class="field__input" id="f-guests" name="persoane">
              <option value="">{f.choose}</option>
              {Array.from({ length: 10 }, (_, i) => i + 1).map((n) => <option value={n}>{n}</option>)}
            </select>
          </div>
        </div>
      </div>

      <div class="names" data-rsvp-names></div>
      <template data-rsvp-name-tpl>
        <div class="name-row">
          <div class="field">
            <label class="field__label"></label>
            <input class="field__input" type="text" maxlength="120" />
          </div>
        </div>
      </template>

      <fieldset class="field choice">
        <legend class="field__label">{f.attending}</legend>
        <div class="choice__opts">
          <label class="choice__opt">
            <input type="radio" name="prezenta" value="da" />
            <span class="choice__box">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>
              {f.yes}
            </span>
          </label>
          <label class="choice__opt">
            <input type="radio" name="prezenta" value="nu" />
            <span class="choice__box">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M7 7l10 10M17 7 7 17"></path></svg>
              {f.no}
            </span>
          </label>
        </div>
      </fieldset>

      <div class="field">
        <label class="field__label" for="f-msg">{f.message}</label>
        <textarea class="field__input field__area" id="f-msg" name="mesaj" rows="3" maxlength="1000" placeholder={f.messagePh}></textarea>
      </div>
    </form>

    <a class="btn btn--wa rsvp__wa" data-rsvp-wa href={wa} target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
        ><path
          d="M12 2.2A9.8 9.8 0 0 0 3.6 17l-1.3 4.8 4.9-1.3A9.8 9.8 0 1 0 12 2.2Zm0 17.9a8.1 8.1 0 0 1-4.1-1.1l-.3-.2-2.9.8.8-2.8-.2-.3A8.1 8.1 0 1 1 12 20.1Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.6 6.6 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.9 11.9 0 0 0 4.6 4c1.7.7 2.3.8 3.2.7.5-.1 1.5-.6 1.7-1.2s.2-1.1.2-1.2-.2-.2-.4-.3Z"
        ></path></svg
      >
      {rsvp.whatsapp}
    </a>
  </div>
</section>

<style>
  .rsvp {
    position: relative;
    isolation: isolate;
    background: var(--night);
    color: var(--ivory);
    padding-bottom: clamp(4rem, 10vw, 8rem);
    /* Poza și titlul stau în aceeași celulă: dacă titlul + textul sunt mai înalte decât poza
       (landscape, text mărit), banda crește odată cu ele și panoul nu le mai acoperă. */
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    /* cât urcă panoul peste poză */
    --rsvp-overlap: clamp(9rem, 30svh, 14rem);
  }
  .rsvp__bg {
    position: relative;
    grid-area: 1 / 1;
    /* pe ecrane foarte late (zoom 50%) banda nu devine o fâșie îngustă */
    min-height: clamp(30rem, 92svh, max(56rem, 40vw));
    overflow: hidden;
    background: #2a1a12;
  }
  .rsvp__media {
    position: absolute;
    inset: -8% 0;
  }
  .rsvp__media :global(.rsvp__pic),
  .rsvp__media :global(.rsvp__img) {
    width: 100%;
    height: 100%;
  }
  .rsvp__media :global(.rsvp__img) {
    object-fit: cover;
    object-position: 50% 22%;
    background-size: cover;
  }
  .rsvp__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgb(6 20 13 / 0.88) 0%, rgb(6 20 13 / 0.3) 38%, transparent 55%, rgb(6 20 13 / 0.9) 100%),
      rgb(11 36 24 / 0.25);
  }
  .rsvp__head {
    position: relative;
    grid-area: 1 / 1;
    align-self: start;
    z-index: 2;
    padding-top: clamp(5rem, 12vw, 9rem);
    padding-bottom: calc(var(--rsvp-overlap) + 2rem);
  }
  .rsvp__title {
    max-width: 9em;
  }
  .rsvp__intro {
    margin-top: 1.25rem;
    max-width: 28rem;
    color: var(--on-dark-soft);
  }

  .rsvp__panel {
    position: relative;
    z-index: 2;
    width: min(100% - 2 * clamp(0.75rem, 3vw, 2rem), 44rem);
    margin: calc(-1 * var(--rsvp-overlap)) auto 0;
    padding: 6.75rem clamp(1.25rem, 6vw, 4rem) clamp(2rem, 6vw, 3.5rem);
    border-radius: 50% 50% 1.5rem 1.5rem / 10rem 10rem 1.5rem 1.5rem;
    border: 1px solid rgb(201 165 90 / 0.7);
    box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.7);
    color-scheme: dark;
  }
  :global(.motion-ok) .rsvp__panel {
    will-change: transform;
  }
  @media (max-width: 37.5em) {
    .rsvp__panel {
      border-radius: 50% 50% 1.25rem 1.25rem / 7rem 7rem 1.25rem 1.25rem;
      padding-top: 6.25rem;
    }
  }
  .rsvp__panel::before {
    content: '';
    position: absolute;
    inset: 10px;
    border: 1px solid rgb(201 165 90 / 0.4);
    border-radius: inherit;
    pointer-events: none;
  }

  .rsvp__please {
    position: absolute;
    top: 2.6rem;
    left: 0;
    right: 0;
    text-align: center;
    font-family: var(--font-hand);
    font-style: italic;
    font-size: 1.5rem;
    color: var(--amber);
  }
  @media (max-width: 37.5em) {
    .rsvp__please {
      top: 2.4rem;
    }
  }

  /* ── Formular ──────────────────────────────────────────────────────── */
  .form {
    display: grid;
    gap: 1.75rem;
  }
  .field {
    display: grid;
    gap: 0.45rem;
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }
  .field__label {
    padding: 0;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    line-height: 1.35;
    color: var(--amber-soft);
  }
  .field__input {
    width: 100%;
    min-height: 48px;
    padding: 0.6rem 0.1rem;
    border: 0;
    border-bottom: 1px solid rgb(201 165 90 / 0.50);
    border-radius: 0;
    background: transparent;
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--ivory);
    transition: border-color 0.3s;
    appearance: none;
  }
  .field__input::placeholder {
    color: rgb(244 237 225 / 0.42);
  }
  .field__input:hover {
    border-bottom-color: var(--ivory);
  }
  .field__input:focus-visible {
    outline: none;
    border-bottom-color: var(--ivory);
    box-shadow: 0 2px 0 0 var(--amber);
  }
  .field__area {
    resize: vertical;
    min-height: 5.5rem;
    line-height: 1.5;
  }
  .field__select {
    position: relative;
  }
  .field__select::after {
    content: '';
    position: absolute;
    right: 0.4rem;
    top: 50%;
    width: 8px;
    height: 8px;
    border-right: 1.5px solid var(--amber-soft);
    border-bottom: 1.5px solid var(--amber-soft);
    transform: translateY(-70%) rotate(45deg);
    pointer-events: none;
  }
  .field__select select {
    padding-right: 2rem;
    cursor: pointer;
  }
  .form__more {
    display: grid;
    gap: 1.75rem;
  }
  .names {
    display: grid;
    margin-block: -0.875rem; /* compensă gap-ul când e gol */
  }
  .names :global(.name-row) {
    display: grid;
    grid-template-rows: 1fr;
    padding-block: 0.875rem;
    opacity: 1;
  }
  .names :global(.name-row > .field) {
    min-height: 0;
    overflow: hidden;
    padding: 0.2rem 0.2rem 0; /* loc pentru linia de focus */
    margin: -0.2rem -0.2rem 0;
  }
  :global(.motion-ok) .names :global(.name-row.is-in) {
    animation: name-in 0.45s var(--ease-out) both;
  }
  :global(.motion-ok) .names :global(.name-row.is-out) {
    animation: name-out 0.3s ease-in both;
    pointer-events: none;
  }
  @keyframes name-in {
    from { grid-template-rows: 0fr; padding-block: 0; opacity: 0; }
  }
  @keyframes name-out {
    to { grid-template-rows: 0fr; padding-block: 0; opacity: 0; }
  }
  .form__more[hidden] {
    display: none;
  }

  .choice__opts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin-top: 0.4rem;
  }
  .choice__opt {
    position: relative;
    display: block;
  }
  .choice__opt input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }
  .choice__box {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 3.25rem;
    padding: 0.7rem 0.75rem;
    border: 1px solid rgb(201 165 90 / 0.45);
    border-radius: 1.6rem 1.6rem 0.6rem 0.6rem;
    font-weight: 600;
    font-size: 1.2rem;
    text-align: center;
    color: var(--ivory);
    transition:
      background-color 0.3s,
      color 0.3s,
      border-color 0.3s,
      transform 0.3s var(--ease-out);
  }
  .choice__box svg {
    width: 1.1rem;
    height: 1.1rem;
    flex: none;
    opacity: 0;
    transform: scale(0.5);
    transition:
      opacity 0.3s,
      transform 0.4s var(--ease-out);
  }
  @media (max-width: 26.25em) {
    .choice__box {
      font-size: 1.05rem;
      padding-inline: 0.5rem;
      gap: 0.35rem;
    }
  }
  .choice__opt:hover .choice__box {
    border-color: var(--ivory);
  }
  .choice__opt input:checked + .choice__box {
    background: var(--amber);
    border-color: var(--amber);
    color: var(--night);
  }
  .choice__opt input:checked + .choice__box svg {
    opacity: 1;
    transform: none;
  }
  .choice__opt input:focus-visible + .choice__box {
    outline: 2px solid var(--amber-soft);
    outline-offset: 3px;
  }
  .choice__opt input:active + .choice__box {
    transform: scale(0.97);
  }
  .rsvp__wa {
    margin-top: 2rem;
    width: 100%;
    min-height: 3.5rem;
  }
</style>
