---
/** Segment din „firul auriu" care leagă secțiunile; se desenează la scroll. */
interface Props {
  height?: string;
  variant?: 's' | 'straight' | 'loop';
  knot?: boolean;
  class?: string;
}
const { height = 'clamp(6rem, 18vh, 11rem)', variant = 's', knot = false, class: cls } = Astro.props;
const d = {
  s: 'M20 0 C20 50 6 70 6 100 S20 150 20 200',
  straight: 'M20 0 L20 200',
  loop: 'M20 0 C20 60 20 80 20 100 C20 130 4 128 6 112 C8 96 34 98 32 120 C30 142 20 150 20 200',
}[variant];
---

<div class:list={['tl', cls]} style={`--h:${height}`} aria-hidden="true">
  <svg viewBox="0 0 40 200" preserveAspectRatio="none" focusable="false">
    <path class="thread" d={d} pathLength="1" data-draw></path>
  </svg>
  {knot && <span class="tl__knot" data-reveal="scale" />}
</div>

<style>
  .tl {
    position: relative;
    width: 40px;
    height: var(--h);
    margin-inline: auto;
  }
  .tl svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .tl__knot {
    position: absolute;
    left: 50%;
    bottom: -5px;
    width: 9px;
    height: 9px;
    margin-left: -4.5px;
    border: 1px solid var(--amber);
    background: var(--amber);
    transform: rotate(45deg);
  }
  :global(.js) .tl__knot:not(:global(.is-in)) {
    transform: rotate(45deg) scale(0) !important;
  }
</style>
