---
/**
 * <picture> responsive: AVIF + WebP + JPEG fallback, srcset/sizes, width/height
 * (fără CLS), art direction opțional (crop separat pentru mobil) și LQIP ca fundal.
 */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  widths: number[];
  sizes: string;
  mobile?: ImageMetadata;
  mobileWidths?: number[];
  mobileSizes?: string;
  mobileMedia?: string;
  priority?: boolean;
  lqip?: string;
  class?: string;
  imgClass?: string;
  pictureAttrs?: Record<string, string>;
  imgAttrs?: Record<string, string>;
}

const {
  src,
  alt,
  widths,
  sizes,
  mobile,
  mobileWidths = [480, 720, 960],
  mobileSizes = '100vw',
  mobileMedia = '(max-width: 767px)',
  priority = false,
  lqip,
  class: className,
  imgClass,
  pictureAttrs = {},
  imgAttrs = {},
} = Astro.props;

const QUALITY = { avif: 52, webp: 72, jpg: 78 } as const;
type Fmt = keyof typeof QUALITY;

async function srcset(img: ImageMetadata, ws: number[], format: Fmt) {
  const list = [...new Set(ws.map((w) => Math.min(w, img.width)))];
  const out = await Promise.all(
    list.map(async (w) => {
      const r = await getImage({ src: img, width: w, format, quality: QUALITY[format] });
      return `${r.src} ${w}w`;
    }),
  );
  return out.join(', ');
}

const formats: Fmt[] = ['avif', 'webp'];
const desktopSets = await Promise.all(formats.map((f) => srcset(src, widths, f)));
const mobileSets = mobile ? await Promise.all(formats.map((f) => srcset(mobile, mobileWidths, f))) : [];
const jpgSet = await srcset(src, widths, 'jpg');
const fallbackW = Math.min(widths[Math.min(1, widths.length - 1)], src.width);
const fallback = await getImage({ src, width: fallbackW, format: 'jpg', quality: QUALITY.jpg });

const style = lqip ? `background-image:url(${lqip})` : undefined;
---

<picture class={className} {...pictureAttrs}>
  {
    mobile &&
      formats.map((f, i) => (
        <source
          media={mobileMedia}
          type={`image/${f}`}
          srcset={mobileSets[i]}
          sizes={mobileSizes}
          width={mobile.width}
          height={mobile.height}
        />
      ))
  }
  {formats.map((f, i) => <source type={`image/${f}`} srcset={desktopSets[i]} sizes={sizes} />)}
  <img
    src={fallback.src}
    srcset={jpgSet}
    sizes={sizes}
    alt={alt}
    width={src.width}
    height={src.height}
    class:list={['img', imgClass]}
    style={style}
    loading={priority ? 'eager' : 'lazy'}
    decoding="async"
    fetchpriority={priority ? 'high' : 'auto'}
    {...imgAttrs}
  />
</picture>
