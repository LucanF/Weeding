---
import { couple, footer, date } from '../data/wedding';
---

<footer class="ftr">
  <div class="container ftr__inner">
    <p class="ftr__names">{couple.bride} <span class="amp">&amp;</span> {couple.groom} · {date.year}</p>
    <p class="ftr__made">{footer.made}</p>
    <a class="ftr__top" href="#acasa">
      {footer.top}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 19V5m-6 6 6-6 6 6"></path></svg>
    </a>
  </div>
</footer>

<style>
  .ftr {
    background: var(--night);
    color: var(--on-dark-soft);
    border-top: 1px solid rgb(201 165 90 / 0.18);
    padding: 2rem 0 calc(2rem + env(safe-area-inset-bottom));
    font-size: var(--fs-small);
  }
  .ftr__inner {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 0.5rem;
  }
  .ftr__names {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.35rem;
    color: var(--ivory);
  }
  .ftr__names .amp {
    font-size: 1.3em;
  }
  .ftr__top {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    text-decoration: none;
    font-size: 1rem;
  }
  .ftr__top svg {
    width: 16px;
    height: 16px;
    transition: transform 0.4s var(--ease-out);
  }
  .ftr__top:hover {
    color: var(--amber);
  }
  .ftr__top:hover svg {
    transform: translateY(-3px);
  }
  @media (min-width: 768px) {
    .ftr__inner {
      grid-template-columns: 1fr auto 1fr;
      text-align: left;
    }
    .ftr__names {
      justify-self: start;
    }
    .ftr__top {
      justify-self: end;
    }
  }
</style>
