---
import ThreadLine from './ui/ThreadLine.astro';
import Rings from './ui/Rings.astro';
import Ornament from './ui/Ornament.astro';
import VenueIcon from './ui/VenueIcon.astro';
import { couple, date, events, invitation } from '../data/wedding';
import decor from '../data/decor.json';

/* Colțurile (scripts/build-florals.mjs): florile au aceeași mărime în toate patru, deci fiecare
   colț e lat cât decupajul lui din sursă × --cu (px CSS la 1000 px sursă; vezi .card-inv).
   `sizes` urmează aceeași formulă: 44vw pe telefon, plafonat la 15.5rem (248 px). */
const corners = (['tl', 'tr', 'bl', 'br'] as const).map((k) => {
  const d = decor[`flora-${k}`];
  const f = d.src / 1000;
  return {
    k,
    f,
    src: `/decor/flora-${k}.webp`,
    srcset: `/decor/flora-${k}-sm.webp ${d.sm}w, /decor/flora-${k}.webp ${d.w}w`,
    sizes: `(min-width: 564px) ${Math.round(248 * f)}px, ${Math.round(44 * f)}vw`,
    w: d.w,
    h: d.h,
  };
});

/* „A” din fontul script (Great Vibes) se citește greu: îl scriem cu fontul textului de invitație (--hand). */
const withHandA = (n: string) => n.split(/(A)/);

const stripQuotes = (s: string) => s.replace(/[„”"]/g, '');
const venues = events.items.map((e) => ({
  ...e,
  label: stripQuotes(e.place),
  icon: e.id === 'cununie' ? ('church' as const) : ('toast' as const),
}));
---

<section class="inv on-ivory" id="invitatie" data-invite aria-labelledby="inv-title">
  <div class="inv__inner">
    <ThreadLine height="clamp(6rem, 18vh, 11rem)" variant="straight" knot />

    <!-- Invitația „tipărită": chenar auriu dublu și o margine florală ca pe invitația de hârtie:
         patru buchete fotorealiste, câte unul pentru fiecare colț (trandafiri crem / piersică /
         roz / vișinii, bujori, orhidee, frunze aurii, perle), legate pe laterale de o ghirlandă
         cu perle, trandafiri și orhidee (::before / ::after). Totul static: fără animații sau filtre. -->
    <article class="card-inv">
      {
        corners.map((c) => (
          <img
            class={`card-inv__corner card-inv__corner--${c.k}`}
            style={`--f:${c.f}`}
            src={c.src}
            srcset={c.srcset}
            sizes={c.sizes}
            alt=""
            width={c.w}
            height={c.h}
            loading="lazy"
            decoding="async"
          />
        ))
      }

      <div class="card-inv__body">
        <div class="card-inv__rings" data-reveal="scale"><Rings /></div>
        <h2 class="sr-only" id="inv-title">{invitation.kicker}</h2>
        <p class="card-inv__couple gold-text" data-reveal style="--d:80" aria-hidden="true">
          {couple.bride} <span class="card-inv__amp">&amp;</span> {couple.groom}
        </p>

        <p class="inv__text" data-words>{invitation.text}</p>

        <Ornament class="card-inv__orn" />

        <p class="inv__label inv__lead" data-reveal>{invitation.parentsLead}</p>

        <div class="inv__families">
          {
            invitation.parents.map((p, i) => (
              <div class="inv__fam" data-reveal style={`--d:${i * 120}`}>
                <p class="inv__label">{p.label}</p>
                <p class="inv__names">{p.names.map((n) => <span>{withHandA(n).map((t) => (t === "A" ? <span class="hand-a">A</span> : t))}</span>)}</p>
              </div>
            ))
          }
        </div>

        <Ornament class="card-inv__orn" />

        <div class="inv__fam inv__fam--god" data-reveal>
          <p class="inv__label">{invitation.godparents.label}</p>
          <p class="inv__names">{invitation.godparents.names.map((n) => <span>{withHandA(n).map((t) => (t === "A" ? <span class="hand-a">A</span> : t))}</span>)}</p>
        </div>

        <Ornament class="card-inv__orn" />

        <p class="card-inv__date" data-reveal>
          <time datetime={date.start.slice(0, 10)}>
            <span class="card-inv__day">{date.day}</span>
            <span class="card-inv__sep" aria-hidden="true"></span>
            <span class="card-inv__my"><span>{date.month}</span><span>{date.year}</span></span>
          </time>
        </p>

        <ul class="card-inv__venues" role="list">
          {
            venues.map((v, i) => (
              <li class="venue" data-reveal style={`--d:${i * 140}`}>
                <span class="venue__icon"><VenueIcon name={v.icon} /></span>
                <span class="venue__txt">
                  <span class="venue__time">ora {v.time}</span>
                  <span class="venue__place">{v.label}</span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </article>

    <ThreadLine variant="loop" height="clamp(7rem, 20vh, 12rem)" />
  </div>
</section>

<style>
  /* Vine după poveste (arcul de peste hero e acum pe .story). */
  .inv {
    position: relative;
    isolation: isolate;
    padding-bottom: 0;
  }

  /* Pe ecrane late, catifeaua din jurul cartonașului primește câte o ramură (trandafiri, bujori,
     orhidee, perle) lângă marginile ecranului: două ghirlande diferite, rotite vertical. Doar fundal
     CSS în media query → pe telefon nu se descarcă deloc; static, fără filtre. */
  @media (min-width: 1024px) {
    .inv::before,
    .inv::after {
      content: '';
      position: absolute;
      z-index: -1;
      top: 24%;
      left: max(0.5rem, (100vw - 48rem) / 4 - 6.5rem);
      width: min(13rem, (100vw - 48rem) / 2 - 1rem);
      aspect-ratio: 273 / 522;
      background: url('/decor/edge-l.webp') 0 0 / 100% 100% no-repeat;
      pointer-events: none;
    }
    .inv::after {
      top: auto;
      left: auto;
      right: max(0.5rem, (100vw - 48rem) / 4 - 6.5rem);
      bottom: 14%;
      aspect-ratio: 275 / 737;
      background-image: url('/decor/edge-r.webp');
    }
  }

  /* ── Cartonașul invitației ─────────────────────────────────────────── */
  .card-inv {
    position: relative;
    width: min(100% - 2 * clamp(0.75rem, 3vw, 2rem), 46rem);
    margin: clamp(0.5rem, 2vw, 1.5rem) auto;
    /* --cu: lățimea în px CSS a 1000 px din sursa buchetelor (aceeași scară pentru toate colțurile);
       buchetele au ≈ 1.0 × --cu înălțime. Sus/jos: loc pentru buchete, ca să nu acopere textul.
       Lateral: loc pentru ghirlanda de pe margini (--gw) + puțin aer. */
    --cu: clamp(8.25rem, 44vw, 15.5rem);
    --gw: clamp(1.5rem, 6.5vw, 2.5rem);
    padding: calc(var(--cu) * 0.55) max(calc(var(--gw) + 0.5rem), clamp(1.25rem, 6vw, 4.5rem)) calc(var(--cu) * 0.95);
    border: 1px solid rgb(201 165 90 / 0.75);
    border-radius: 2px;
    background:
      radial-gradient(90% 55% at 50% 0%, rgb(46 98 66 / 0.35), transparent 70%),
      radial-gradient(80% 50% at 50% 100%, rgb(0 0 0 / 0.3), transparent 70%),
      url('/decor/velvet.webp') 0 0 / 512px 512px,
      var(--emerald-2);
    box-shadow:
      0 0 0 6px var(--emerald),
      0 0 0 7px rgb(201 165 90 / 0.4),
      0 40px 80px -40px rgb(0 0 0 / 0.8);
    text-align: center;
    overflow: clip;
    isolation: isolate;
    /* Cartonașul reproduce invitația tipărită: aici textul rămâne scris de mână. */
    font-family: var(--hand);
    font-weight: 400;
    line-height: 1.55;
  }
  /* Ghirlanda de pe margini: vrej auriu cu perle, frunze aurii și verzi, trandafiri roz și
     orhidee (cele două șiruri verticale din planșă, unul sub altul, repetate). Începe sub brațul
     vertical al buchetelor și se estompează spre ele. */
  .card-inv::before,
  .card-inv::after {
    content: '';
    position: absolute;
    z-index: -1;
    top: calc(var(--cu) * 0.8);
    bottom: calc(var(--cu) * 0.75);
    left: 2px;
    width: var(--gw);
    background: url('/decor/garland.webp') 50% 0 / 100% auto repeat-y;
    -webkit-mask-image: linear-gradient(transparent, #000 4rem, #000 calc(100% - 4rem), transparent);
    mask-image: linear-gradient(transparent, #000 4rem, #000 calc(100% - 4rem), transparent);
    pointer-events: none;
  }
  /* dreapta: oglindită și decalată, ca cele două laterale să nu fie identice */
  .card-inv::after {
    left: auto;
    right: 2px;
    top: calc(var(--cu) * 0.85);
    bottom: calc(var(--cu) * 0.7);
    background-position: 50% calc(var(--gw) * -8.8);
    transform: scaleX(-1);
  }
  /* Buchetele din colțuri (scripts/build-florals.mjs): lățime = decupaj-sursă × --cu,
     aspect-ratio din atributele width/height → fără layout shift. */
  .card-inv__corner {
    position: absolute;
    z-index: 0;
    pointer-events: none;
    width: calc(var(--f) * var(--cu));
    max-width: none;
    height: auto;
  }
  .card-inv__corner--tl {
    top: 0;
    left: 0;
  }
  .card-inv__corner--tr {
    top: 0;
    right: 0;
  }
  .card-inv__corner--bl {
    bottom: 0;
    left: 0;
  }
  .card-inv__corner--br {
    bottom: 0;
    right: 0;
  }
  .card-inv__body {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
  }
  .card-inv__rings {
    width: clamp(4.5rem, 16vw, 6.5rem);
  }
  .card-inv__couple {
    margin-top: 0.75rem;
    font-family: var(--serif);
    font-size: clamp(2.9rem, 11vw, 5.25rem);
    line-height: 1.15;
    padding: 0.05em 0.15em 0.15em;
  }
  .card-inv__amp {
    font-size: 0.85em;
  }
  .inv__text {
    margin-top: clamp(1rem, 3vw, 1.75rem);
    max-width: 24em;
    font-family: var(--hand);
    font-size: clamp(1.3rem, 3.6vw, 1.75rem);
    line-height: 1.35;
    color: var(--ivory);
    text-wrap: balance;
  }
  .inv__text :global(.word) {
    will-change: auto;
  }
  .card-inv :global(.card-inv__orn) {
    margin-block: clamp(1.5rem, 4vw, 2.25rem);
  }
  .inv__families {
    display: grid;
    gap: 1.5rem;
    width: 100%;
  }
  .inv__label {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--amber);
  }
  .inv__names {
    margin-top: 0.4rem;
    font-family: var(--serif);
    font-size: clamp(1.7rem, 5vw, 2.2rem);
    line-height: 1.2;
    color: var(--ivory);
  }
  .inv__names :global(.hand-a) {
    display: inline;
    font-family: var(--hand);
    font-size: 0.85em;
  }
  /* Fiecare nume pe rândul lui (ex. mama; tata cu soția). */
  .inv__names span {
    display: block;
  }
  .inv__names span + span {
    margin-top: 0.25em;
  }
  @media (min-width: 640px) {
    .inv__families {
      grid-template-columns: 1fr 1fr;
      column-gap: 2.5rem;
    }
  }

  /* ── Data: 29 | MAI 2027 ─────────────────────────────────────────── */
  .card-inv__date time {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    color: var(--amber-soft);
  }
  .card-inv__day {
    font-family: var(--num);
    font-weight: 600;
    font-size: clamp(3.75rem, 14vw, 5rem);
    line-height: 1;
  }
  .card-inv__sep {
    width: 1px;
    align-self: stretch;
    background: linear-gradient(transparent, var(--amber), transparent);
  }
  .card-inv__my {
    display: grid;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-align: left;
    font-family: var(--num);
    font-weight: 600;
    font-size: clamp(1.5rem, 5vw, 1.9rem);
    line-height: 1.05;
  }

  /* ── Cele două locuri, cu pictogramele aurii ─────────────────────── */
  .card-inv__venues {
    display: grid;
    gap: 1.5rem;
    width: 100%;
    max-width: 36rem;
    margin-top: clamp(1.75rem, 5vw, 2.5rem);
  }
  .venue {
    display: grid;
    grid-template-columns: clamp(4.25rem, 18vw, 5.25rem) 1fr;
    align-items: center;
    gap: 1rem;
    text-align: left;
  }
  .venue__icon {
    color: var(--amber);
  }
  .venue__txt {
    display: grid;
    gap: 0.15rem;
  }
  .venue__time {
    font-family: var(--num);
    font-weight: 600;
    font-size: 1.35rem;
    color: var(--amber-soft);
  }
  .venue__place {
    font-size: 1.1rem;
    line-height: 1.3;
    color: var(--ivory);
  }
  @media (min-width: 640px) {
    .card-inv__venues {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
