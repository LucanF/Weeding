---
import ThreadLine from './ui/ThreadLine.astro';
import Rings from './ui/Rings.astro';
import Ornament from './ui/Ornament.astro';
import VenueIcon from './ui/VenueIcon.astro';
import { couple, date, events, invitation } from '../data/wedding';

const stripQuotes = (s: string) => s.replace(/[„”"]/g, '');
const venues = events.items.map((e) => ({
  ...e,
  label: stripQuotes(e.place),
  icon: e.id === 'cununie' ? ('church' as const) : ('toast' as const),
}));
---

<section class="inv on-ivory" id="invitatie" data-invite aria-labelledby="inv-title">
  <div class="inv__inner">
    <ThreadLine height="clamp(6rem, 18vh, 11rem)" variant="straight" knot />

    <!-- Invitația „tipărită": chenar auriu dublu și o margine florală ca pe invitația de hârtie:
         buchete în toate cele patru colțuri (trandafiri crem / piersică / roz / vișinii, bujori,
         orhidee, frunze aurii, perle) legate pe laterale de un vrej auriu cu perle, trandafiri
         mici și orhidee (::before / ::after). Totul static: fără animații sau filtre. -->
    <article class="card-inv" id="continut">
      <img class="card-inv__corner card-inv__corner--tl" src="/decor/flora-tl.webp" alt="" width="420" height="605" loading="lazy" decoding="async" />
      <img class="card-inv__corner card-inv__corner--tr" src="/decor/flora-tr.webp" alt="" width="420" height="605" loading="lazy" decoding="async" />
      <img class="card-inv__corner card-inv__corner--bl" src="/decor/flora-bl.webp" alt="" width="420" height="605" loading="lazy" decoding="async" />
      <img class="card-inv__corner card-inv__corner--br" src="/decor/flora-br.webp" alt="" width="420" height="605" loading="lazy" decoding="async" />

      <div class="card-inv__body">
        <div class="card-inv__rings" data-reveal="scale"><Rings /></div>
        <h2 class="sr-only" id="inv-title">{invitation.kicker}</h2>
        <p class="card-inv__couple gold-text" data-reveal style="--d:80" aria-hidden="true">
          {couple.bride} <span class="card-inv__amp">&amp;</span> {couple.groom}
        </p>

        <p class="inv__text" data-words>{invitation.text}</p>

        <Ornament class="card-inv__orn" />

        <div class="inv__families">
          {
            invitation.parents.map((p, i) => (
              <div class="inv__fam" data-reveal style={`--d:${i * 120}`}>
                <p class="inv__label">{p.label}</p>
                <p class="inv__names">{p.names.map((n) => <span>{n}</span>)}</p>
              </div>
            ))
          }
        </div>

        <Ornament class="card-inv__orn" />

        <div class="inv__fam inv__fam--god" data-reveal>
          <p class="inv__label">{invitation.godparents.label}</p>
          <p class="inv__names">{invitation.godparents.names.map((n) => <span>{n}</span>)}</p>
        </div>

        <Ornament class="card-inv__orn" />

        <p class="card-inv__date" data-reveal>
          <time datetime={date.start.slice(0, 10)}>
            <span class="card-inv__day">{date.day}</span>
            <span class="card-inv__sep" aria-hidden="true"></span>
            <span class="card-inv__my"><span>{date.month}</span><span>{date.year}</span></span>
          </time>
        </p>

        <ul class="card-inv__venues" role="list">
          {
            venues.map((v, i) => (
              <li class="venue" data-reveal style={`--d:${i * 140}`}>
                <span class="venue__icon"><VenueIcon name={v.icon} /></span>
                <span class="venue__txt">
                  <span class="venue__time">ora {v.time}</span>
                  <span class="venue__place">{v.label}</span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </article>

    <ThreadLine variant="loop" height="clamp(7rem, 20vh, 12rem)" />
  </div>
</section>

<style>
  /* Secțiunea urcă peste poza din hero cu marginea de sus arcuită (motivul arcadei). */
  .inv {
    position: relative;
    z-index: 5;
    isolation: isolate;
    padding-bottom: 0;
    margin-top: calc(-1 * var(--seam));
    border-radius: 50% 50% 0 0 / var(--seam) var(--seam) 0 0;
  }

  /* Pe ecrane late, catifeaua din jurul cartonașului primește câte o ramură (orhidee, trandafiri,
     bujor, perle) lipită de marginile ecranului; dreapta e aceeași imagine, oglindită. Doar fundal
     CSS în media query → pe telefon nu se descarcă deloc; static, fără filtre. */
  @media (min-width: 1024px) {
    .inv::before,
    .inv::after {
      content: '';
      position: absolute;
      z-index: -1;
      top: 22%;
      left: 0;
      width: min(17rem, (100vw - 48rem) / 2);
      aspect-ratio: 300 / 900;
      background: url('/decor/edge-l.webp') 0 0 / 100% 100% no-repeat;
      pointer-events: none;
    }
    .inv::after {
      top: auto;
      left: auto;
      right: 0;
      bottom: 12%;
      transform: scaleX(-1);
    }
  }

  /* ── Cartonașul invitației ─────────────────────────────────────────── */
  .card-inv {
    position: relative;
    width: min(100% - 2 * clamp(0.75rem, 3vw, 2rem), 46rem);
    margin: clamp(0.5rem, 2vw, 1.5rem) auto;
    /* jos: loc pentru buchetul din colț, ca să nu acopere locurile */
    /* lateral: loc pentru ghirlanda de pe margini (--gw) + puțin aer */
    --gw: clamp(1.5rem, 6.5vw, 2.5rem);
    padding: clamp(3.25rem, 9vw, 5rem) max(calc(var(--gw) + 0.5rem), clamp(1.25rem, 6vw, 4.5rem)) clamp(9rem, 34vw, 13.5rem);
    border: 1px solid rgb(201 165 90 / 0.75);
    border-radius: 2px;
    background:
      radial-gradient(90% 55% at 50% 0%, rgb(46 98 66 / 0.35), transparent 70%),
      radial-gradient(80% 50% at 50% 100%, rgb(0 0 0 / 0.3), transparent 70%),
      url('/decor/velvet.webp') 0 0 / 512px 512px,
      var(--emerald-2);
    box-shadow:
      0 0 0 6px var(--emerald),
      0 0 0 7px rgb(201 165 90 / 0.4),
      0 40px 80px -40px rgb(0 0 0 / 0.8);
    text-align: center;
    overflow: clip;
    isolation: isolate;
    /* Cartonașul reproduce invitația tipărită: aici textul rămâne scris de mână. */
    font-family: var(--hand);
    font-weight: 400;
    line-height: 1.55;
  }
  /* Ghirlanda de pe margini: vrej auriu, frunze aurii și verzi, șirag de perle, trandafiri mici
     și câte o orhidee (un SVG repetat vertical, ~3 KB gzip). Se estompează spre buchetele din
     colțuri. Statică: rasterizată o dată. */
  .card-inv::before,
  .card-inv::after {
    content: '';
    position: absolute;
    z-index: -1;
    top: clamp(7rem, 30vw, 11rem);
    bottom: clamp(8rem, 30vw, 12rem);
    left: 3px;
    width: var(--gw);
    background: url('/decor/garland.svg') 50% 0 / 100% auto repeat-y;
    -webkit-mask-image: linear-gradient(transparent, #000 4rem, #000 calc(100% - 4rem), transparent);
    mask-image: linear-gradient(transparent, #000 4rem, #000 calc(100% - 4rem), transparent);
    pointer-events: none;
  }
  /* dreapta: oglindită și decalată, ca cele două laterale să nu fie identice */
  .card-inv::after {
    left: auto;
    right: 3px;
    top: clamp(10rem, 44vw, 16rem);
    bottom: clamp(7rem, 26vw, 10rem);
    background-position: 50% calc(var(--gw) * 2.5);
    transform: scaleX(-1);
  }
  /* Buchetele din colțuri (scripts/build-florals.mjs): același cadru 420×605 pentru toate,
     cu aspect-ratio din atributele width/height → fără layout shift. */
  .card-inv__corner {
    position: absolute;
    z-index: 0;
    pointer-events: none;
    width: clamp(8.25rem, 36%, 14rem);
    height: auto;
  }
  .card-inv__corner--tl {
    top: 0;
    left: 0;
  }
  .card-inv__corner--tr {
    top: 0;
    right: 0;
  }
  .card-inv__corner--bl {
    bottom: 0;
    left: 0;
  }
  .card-inv__corner--br {
    bottom: 0;
    right: 0;
  }
  .card-inv__body {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
  }
  .card-inv__rings {
    width: clamp(4.5rem, 16vw, 6.5rem);
  }
  .card-inv__couple {
    margin-top: 0.75rem;
    font-family: var(--serif);
    font-size: clamp(2.9rem, 11vw, 5.25rem);
    line-height: 1.15;
    padding: 0.05em 0.15em 0.15em;
  }
  .card-inv__amp {
    font-size: 0.85em;
  }
  .inv__text {
    margin-top: clamp(1rem, 3vw, 1.75rem);
    max-width: 24em;
    font-family: var(--hand);
    font-size: clamp(1.3rem, 3.6vw, 1.75rem);
    line-height: 1.35;
    color: var(--ivory);
    text-wrap: balance;
  }
  .inv__text :global(.word) {
    will-change: auto;
  }
  .card-inv :global(.card-inv__orn) {
    margin-block: clamp(1.5rem, 4vw, 2.25rem);
  }
  .inv__families {
    display: grid;
    gap: 1.5rem;
    width: 100%;
  }
  .inv__label {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--amber);
  }
  .inv__names {
    margin-top: 0.4rem;
    font-family: var(--serif);
    font-size: clamp(1.7rem, 5vw, 2.2rem);
    line-height: 1.2;
    color: var(--ivory);
  }
  /* Fiecare nume pe rândul lui (ex. mama; tata cu soția). */
  .inv__names span {
    display: block;
  }
  .inv__names span + span {
    margin-top: 0.25em;
  }
  @media (min-width: 640px) {
    .inv__families {
      grid-template-columns: 1fr 1fr;
      column-gap: 2.5rem;
    }
  }

  /* ── Data: 29 | MAI 2027 ─────────────────────────────────────────── */
  .card-inv__date time {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    color: var(--amber-soft);
  }
  .card-inv__day {
    font-family: var(--num);
    font-weight: 600;
    font-size: clamp(3.75rem, 14vw, 5rem);
    line-height: 1;
  }
  .card-inv__sep {
    width: 1px;
    align-self: stretch;
    background: linear-gradient(transparent, var(--amber), transparent);
  }
  .card-inv__my {
    display: grid;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-align: left;
    font-family: var(--num);
    font-weight: 600;
    font-size: clamp(1.5rem, 5vw, 1.9rem);
    line-height: 1.05;
  }

  /* ── Cele două locuri, cu pictogramele aurii ─────────────────────── */
  .card-inv__venues {
    display: grid;
    gap: 1.5rem;
    width: 100%;
    max-width: 36rem;
    margin-top: clamp(1.75rem, 5vw, 2.5rem);
  }
  .venue {
    display: grid;
    grid-template-columns: clamp(4.25rem, 18vw, 5.25rem) 1fr;
    align-items: center;
    gap: 1rem;
    text-align: left;
  }
  .venue__icon {
    color: var(--amber);
  }
  .venue__txt {
    display: grid;
    gap: 0.15rem;
  }
  .venue__time {
    font-family: var(--num);
    font-weight: 600;
    font-size: 1.35rem;
    color: var(--amber-soft);
  }
  .venue__place {
    font-size: 1.1rem;
    line-height: 1.3;
    color: var(--ivory);
  }
  @media (min-width: 640px) {
    .card-inv__venues {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
