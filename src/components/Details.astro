---
import Img from './ui/Img.astro';
import { events } from '../data/wedding';
import { photos } from '../data/photos';

const mapLinks = (e: (typeof events.items)[number]) => [
  {
    label: events.maps.google,
    href: `https://www.google.com/maps/search/?api=1&query=${e.lat},${e.lng}`,
  },
  { label: events.maps.waze, href: `https://waze.com/ul?ll=${e.lat},${e.lng}&navigate=yes` },
  {
    label: events.maps.apple,
    href: `https://maps.apple.com/?ll=${e.lat},${e.lng}&q=${encodeURIComponent(e.place)}`,
  },
];
---

<div class="band" data-band aria-hidden="true">
  <div class="band__media" data-band-media>
    <Img
      src={photos.apus.src}
      alt=""
      widths={[800, 1280, 2048]}
      sizes="100vw"
      lqip={photos.apus.lqip}
      class="band__pic"
      imgClass="band__img"
    />
  </div>
  <p class="band__text">Ne vedem acolo</p>
</div>

<section class="det on-ivory section" id="detalii" aria-labelledby="det-title">
  <div class="container">
    <header class="det__head">
      <p class="kicker kicker--center" data-reveal>{events.kicker}</p>
      <h2 class="h2" id="det-title" data-reveal style="--d:80">{events.title}</h2>
      <p class="lead det__intro" data-reveal style="--d:160">{events.intro}</p>
    </header>

    <div class="det__grid" data-route>
      <svg class="det__route det__route--h" viewBox="0 0 400 120" preserveAspectRatio="none" aria-hidden="true">
        <path class="thread" pathLength="1" data-draw d="M0 90 C 80 90 90 20 170 30 S 270 110 330 70 S 380 30 400 30"></path>
      </svg>
      <svg class="det__route det__route--v" viewBox="0 0 60 400" preserveAspectRatio="none" aria-hidden="true">
        <path class="thread" pathLength="1" data-draw d="M30 0 C 30 80 6 120 10 200 S 54 300 30 400"></path>
      </svg>

      {
        events.items.map((e, i) => (
          <>
            <article class="card" data-reveal style={`--d:${i * 180}`} aria-labelledby={`ev-${e.id}`}>
              <span class="card__pin" aria-hidden="true">
                <svg viewBox="0 0 24 32">
                  <path d="M12 31s10-11.2 10-19A10 10 0 0 0 2 12c0 7.8 10 19 10 19Z" />
                  <circle cx="12" cy="12" r="3.6" />
                </svg>
              </span>
              <p class="card__type">{e.type}</p>
              <p class="card__time">
                <time datetime={e.time}>{e.time}</time>
              </p>
              <h3 class="card__place" id={`ev-${e.id}`}>
                {e.place}
              </h3>
              <p class="card__addr">{e.address}</p>
              <p class="card__note">{e.note}</p>
              <div class="card__maps" role="group" aria-label={`Navigație către ${e.place}`}>
                {mapLinks(e).map((l) => (
                  <a class="btn btn--sm btn--ghost" href={l.href} target="_blank" rel="noopener">
                    {l.label}
                  </a>
                ))}
              </div>
            </article>
            {i === 0 && (
              <p class="det__eta" data-reveal="fade" style="--d:300">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M4 15.5 5.8 10a2 2 0 0 1 1.9-1.4h8.6a2 2 0 0 1 1.9 1.4l1.8 5.5M3.5 15.5h17v3h-17zM6.5 18.5V20M17.5 18.5V20" />
                  <circle cx="7.5" cy="15.5" r=".6" />
                  <circle cx="16.5" cy="15.5" r=".6" />
                </svg>
                {events.routeLabel}
              </p>
            )}
          </>
        ))
      }
    </div>
  </div>
</section>

<style>
  .band {
    position: relative;
    height: clamp(22rem, 70svh, 46rem);
    overflow: hidden;
    background: var(--forest);
    display: grid;
    place-items: center;
  }
  .band__media {
    position: absolute;
    inset: -12% 0;
  }
  .band__media :global(.band__pic),
  .band__media :global(.band__img) {
    width: 100%;
    height: 100%;
  }
  .band__media :global(.band__img) {
    object-fit: cover;
    object-position: 55% 50%;
    background-size: cover;
  }
  .band::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, var(--forest) 0%, transparent 28%, transparent 62%, rgb(244 237 225 / 0.0) 80%, var(--ivory) 100%),
      rgb(14 13 10 / 0.18);
  }
  .band__text {
    position: relative;
    z-index: 1;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(2.25rem, 7vw, 5rem);
    color: var(--ivory);
    text-shadow: 0 2px 30px rgb(14 13 10 / 0.5);
  }

  .det__head {
    display: grid;
    justify-items: center;
    text-align: center;
  }
  .det__intro {
    margin-top: 1.25rem;
  }
  .det__grid {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0;
    margin-top: clamp(3.5rem, 8vw, 6rem);
  }
  .det__route {
    position: absolute;
    overflow: visible;
    pointer-events: none;
  }
  .det__route--h {
    display: none;
  }
  .det__route--v {
    left: 50%;
    top: 12%;
    height: 76%;
    width: 60px;
    margin-left: -30px;
    z-index: 0;
  }
  .det__eta {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-block: 3.5rem;
    padding: 0.55rem 1rem;
    border-radius: 999px;
    background: var(--ivory);
    border: 1px solid rgb(31 42 30 / 0.14);
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--forest);
  }
  .det__eta svg {
    width: 1.3rem;
    height: 1.3rem;
  }

  .card {
    position: relative;
    z-index: 1;
    width: min(100%, 27rem);
    display: grid;
    justify-items: center;
    text-align: center;
    padding: clamp(3.5rem, 9vw, 4.5rem) clamp(1.25rem, 5vw, 2.5rem) clamp(2rem, 5vw, 2.5rem);
    border-radius: 14rem 14rem 1.25rem 1.25rem;
    background:
      radial-gradient(120% 60% at 50% 0%, rgb(200 146 74 / 0.12), transparent 60%),
      #fbf7ef;
    border: 1px solid rgb(31 42 30 / 0.12);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.6) inset,
      0 30px 60px -30px rgb(31 42 30 / 0.35);
  }
  .card::before {
    content: '';
    position: absolute;
    inset: 10px;
    border-radius: 13.4rem 13.4rem 0.8rem 0.8rem;
    border: 1px solid rgb(200 146 74 / 0.35);
    pointer-events: none;
  }
  .card__pin {
    position: absolute;
    top: -18px;
    left: 50%;
    width: 30px;
    margin-left: -15px;
  }
  .card__pin svg {
    width: 30px;
    height: 40px;
    filter: drop-shadow(0 6px 8px rgb(31 42 30 / 0.25));
  }
  .card__pin path {
    fill: var(--forest);
  }
  .card__pin circle {
    fill: var(--amber);
  }
  .card__type {
    font-size: var(--fs-kicker);
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--moss);
  }
  .card__time {
    margin-top: 0.75rem;
    font-family: var(--serif);
    font-size: clamp(3.5rem, 9vw, 4.75rem);
    line-height: 1;
    color: var(--forest);
    font-feature-settings: 'lnum' 1;
  }
  .card__place {
    margin-top: 0.75rem;
    font-size: clamp(1.5rem, 3vw, 1.9rem);
    font-style: italic;
    line-height: 1.15;
    color: var(--night);
  }
  .card__addr {
    margin-top: 0.5rem;
    color: var(--ink-soft);
  }
  .card__note {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid rgb(31 42 30 / 0.12);
    font-size: var(--fs-small);
    color: var(--ink-soft);
  }
  .card__maps {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  @media (min-width: 900px) {
    .det__grid {
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      column-gap: 1rem;
    }
    .det__route--v {
      display: none;
    }
    .det__route--h {
      display: block;
      left: 18%;
      right: 18%;
      top: 4%;
      width: 64%;
      height: 26%;
    }
    .det__eta {
      margin: 0;
      align-self: start;
      margin-top: 6rem;
    }
    .card:last-child {
      transform: translateY(4rem);
    }
    :global(.js) .card:last-child:not(:global(.is-in)) {
      transform: translateY(6rem);
    }
  }
</style>
