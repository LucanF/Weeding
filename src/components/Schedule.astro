---
import Icon from './ui/Icon.astro';
import { schedule } from '../data/wedding';
---

<section class="sch on-ivory section" id="program" aria-labelledby="sch-title" data-schedule>
  <div class="container sch__grid">
    <div class="sch__aside">
      <div class="sch__sticky">
        <p class="kicker" data-ch data-reveal>{schedule.kicker}</p>
        <h2 class="h2" id="sch-title" data-reveal style="--d:80">{schedule.title}</h2>
        <p class="sch__clock" aria-hidden="true" data-sch-clock>{schedule.items[0].time}</p>
      </div>
    </div>

    <ol class="sch__list" role="list">
      <li class="sch__line" role="presentation" aria-hidden="true"><span data-sch-fill></span></li>
      {
        schedule.items.map((it, i) => (
          <li class="sch__item" data-sch-item data-time={it.time} data-reveal style={`--d:${(i % 2) * 80}`}>
            <span class="sch__icon">
              <Icon name={it.icon} />
            </span>
            <div class="sch__body">
              <p class="sch__time">
                <time datetime={it.time}>{it.time}</time>
              </p>
              <h3 class="sch__title">{it.title}</h3>
              {it.text && <p class="sch__text">{it.text}</p>}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .sch {
    background: var(--velvet);
  }
  .sch__grid {
    display: grid;
    gap: clamp(3rem, 7vw, 5rem);
  }
  .sch__clock {
    display: none;
  }
  .sch__list {
    position: relative;
    display: grid;
    gap: clamp(2.25rem, 5vw, 3rem);
    padding: 0;
  }
  /* Linia verticală: un element simplu scalat pe Y (pe GPU), nu un SVG înalt cu stroke-dash
     (în WebKit se re-desena la fiecare frame și putea deveni ancoră de scroll). */
  .sch__line {
    position: absolute;
    z-index: 0; /* context propriu: scânteia trece pe sub pictograme, nu peste ele */
    left: calc(22px - 0.625px);
    top: 24px;
    width: 1.25px;
    height: calc(100% - 48px);
    overflow-anchor: none;
    pointer-events: none;
  }
  .sch__line > span {
    position: relative;
    overflow: hidden;
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 1px;
    background: var(--amber);
    transform-origin: 50% 0;
  }
  :global(.motion-ok) .sch__line > span {
    transform: scaleY(0);
  }
  .sch__item {
    position: relative;
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 1.25rem;
    align-items: start;
  }
  .sch__icon {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 44px;
    height: 52px;
    border-radius: 22px 22px 8px 8px;
    background: var(--emerald-2);
    border: 1px solid rgb(201 165 90 / 0.31);
    color: var(--ivory);
    transition:
      background-color 0.5s var(--ease-out),
      color 0.5s var(--ease-out),
      transform 0.6s var(--ease-out);
  }
  /* Halo auriu pe momentul activ: umbra e pe un pseudo-element, animăm doar opacitatea lui. */
  .sch__icon::after {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    box-shadow:
      0 0 0 4px rgb(201 165 90 / 0.14),
      0 0 22px 2px rgb(232 208 154 / 0.35);
    opacity: 0;
    transition: opacity 0.6s var(--ease-out);
    pointer-events: none;
  }
  :global(.sch__item.is-active) .sch__icon::after {
    opacity: 1;
  }
  :global(.motion-ok .sch__item.is-active) .sch__icon {
    transform: scale(1.06);
  }
  .sch__icon :global(svg) {
    width: 22px;
    height: 22px;
  }
  :global(.sch__item.is-active) .sch__icon {
    background: var(--amber);
    color: var(--night);
  }
  .sch__time {
    font-family: var(--num);
    font-size: 1.6rem;
    line-height: 1;
    color: var(--amber);
    font-feature-settings: 'lnum' 1, 'tnum' 1;
    /* terracotta e folosit doar la dimensiune mare (contrast AA pentru text mare) */
  }
  .sch__title {
    margin-top: 0.35rem;
    font-size: clamp(1.45rem, 2.6vw, 1.9rem);
    line-height: 1.15;
    color: var(--ivory);
  }
  .sch__text {
    margin-top: 0.3rem;
    color: var(--on-dark-soft);
  }

  @media (min-width: 960px) {
    .sch__grid {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
    .sch__aside {
      align-self: stretch;
    }
    .sch__sticky {
      position: sticky;
      top: calc(var(--header-h) + 3rem);
    }
    .sch__clock {
      display: block;
      margin-top: 2rem;
      font-family: var(--num);
      font-size: clamp(6rem, 12vw, 10.5rem);
      line-height: 1;
      color: var(--ivory);
      font-feature-settings: 'lnum' 1, 'tnum' 1;
      letter-spacing: -0.02em;
    }
    .sch__clock :global(.dg) {
      display: inline-block;
      overflow: hidden;
      height: 1em;
      padding-inline: 0.06em;
      margin-inline: -0.03em;
      vertical-align: top;
    }
    .sch__clock :global(.dg span) {
      display: block;
      height: 1em;
      line-height: 1;
    }
    .sch__clock :global(.dg.is-rolling span) {
      animation: sch-roll 0.6s var(--ease-out) both;
    }
    @keyframes sch-roll {
      to {
        transform: translateY(-100%);
      }
    }
    .sch__list {
      padding-top: 1rem;
      gap: 4.5rem;
    }
    .sch__item {
      grid-template-columns: 52px 1fr;
      gap: 2rem;
    }
    .sch__icon {
      width: 52px;
      height: 62px;
      border-radius: 26px 26px 10px 10px;
    }
    .sch__line {
      left: calc(26px - 0.625px);
    }
    /* Pe desktop ora mare e în ceasul sticky; în listă rămâne o etichetă discretă. */
    .sch__time {
      font-family: var(--num);
      font-size: 1.05rem;
      font-weight: 600;
      color: var(--amber);
    }
    .sch__title {
      margin-top: 0.4rem;
    }
  }
</style>
